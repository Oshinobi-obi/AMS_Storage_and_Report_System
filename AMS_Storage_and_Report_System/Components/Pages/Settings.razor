@page "/settings"
@layout AppLayout
@attribute [Authorize]
@inject SettingsService SettingsSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ModalService Modal
@inject IJSRuntime JS
@inject SeasonState Season

<PageTitle>Settings | e-PINS</PageTitle>

<PageHeader Title="Settings" Subtitle="The seasonal theme, values printed on every Requisition and Issue Slip, and office details used by e-SRS." />

<div class="wrap page-body">
    @if (_form is null)
    {
        <div class="panel"><div class="loading">Loading settings…</div></div>
    }
    else
    {
        <section class="panel">
            <header class="panel-head">
                <h2>Seasonal theme</h2>
                <span class="meta">Dresses up the top bar, the page headers and the sidebar of e-PINS and e-SRS for everyone. Everything else stays the same.</span>
            </header>
            <div class="panel-body">
                <div class="season-picks" role="radiogroup" aria-label="Seasonal theme">
                    @foreach (var opt in SeasonOptions)
                    {
                        var on = _season == opt.Code;
                        <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="season-pick @(on ? "is-on" : "")"
                                disabled="@_seasonSaving" @onclick="() => SetSeasonAsync(opt)">
                            <span class="season-swatch" data-swatch="@opt.Code"><i class="bi @opt.Icon" aria-hidden="true"></i></span>
                            <span class="season-pick-text"><strong>@opt.Name</strong><small>@opt.Note</small></span>
                            @if (on) { <i class="bi bi-check-circle-fill season-check" aria-hidden="true"></i> }
                        </button>
                    }
                </div>
                <p class="small text-muted-2 mb-0 mt-3">
                    <strong>Automatic</strong> changes the theme by itself through the year, on the dates under each theme, and uses the standard look in between.
                    @(Seasons.ByDate(PhTime.Now) is { } today ? $"Today it shows {today.Name}." : "Today it shows the standard look.")
                </p>
            </div>
        </section>

        <section class="panel">
            <header class="panel-head">
                <h2>Requisition rules</h2>
                <span class="meta">How e-SRS checks what offices may request.</span>
            </header>
            <div class="panel-body">
                <div class="setting-switch">
                    <div class="form-check form-switch">
                        <input @key="_appCseKey" class="form-check-input" type="checkbox" role="switch" id="require-appcse"
                               checked="@_appCseRequired" disabled="@_appCseSaving" @onchange="ToggleAppCseAsync" />
                        <label class="form-check-label" for="require-appcse">
                            <strong>Require APP-CSE for requisitions</strong>
                        </label>
                    </div>
                    <p class="small text-muted-2 mb-0 mt-1">
                        @(_appCseRequired
                            ? "On: offices can only request items in their Annual Procurement Plan (APP-CSE), within their remaining balance."
                            : "Off: offices can request any catalog item in any quantity. AMS still checks warehouse stock when approving.")
                    </p>
                </div>
            </div>
        </section>

        <section class="panel">
            <header class="panel-head"><h2>Requisition and Issue Slip</h2></header>
            <div class="panel-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="s-entity">Entity Name</label>
                        <input id="s-entity" class="form-control" maxlength="200" autocomplete="off" @bind="_form.EntityName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="s-fund">Fund Cluster</label>
                        <input id="s-fund" class="form-control" maxlength="10" autocomplete="off" @bind="_form.FundCluster" placeholder="Leave blank to write by hand" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="s-approver">Approved by (default)</label>
                        <Picker TValue="int" Id="s-approver" Options="@(PeopleOptions("Nobody, fill in by hand"))" @bind-Value="_form.ApprovedById" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="s-issuer">Issued by (default)</label>
                        <Picker TValue="int" Id="s-issuer" Options="@(PeopleOptions("Nobody, choose at approval"))" @bind-Value="_form.IssuedById" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="s-reorder">Default low-stock level</label>
                        <input id="s-reorder" type="number" min="0" class="form-control text-end" autocomplete="off" @bind="_form.DefaultReorderLevel" />
                        <div class="form-text">Used for new catalog items.</div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Save settings
                    </button>
                </div>
                <p class="small text-muted-2 mb-0 mt-2">Changes apply to requisitions submitted from now on. Slips already submitted keep their values.</p>
            </div>
        </section>

        <section class="panel">
            <header class="panel-head">
                <h2>Offices</h2>
                <span class="meta">The RIS code (01 ORD, 02 ARD, …) is written in the RIS No. column of the RSMI. Responsibility center codes are printed on the RIS. "APP-CSE sheet" is needed only when the office's sheet in the APP-CSE workbook has another name. "Uses APP-CSE of" lets a unit request on its division's APP-CSE (e.g. LRPO on ESSD's).</span>
            </header>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>Office</th><th style="width: 100px">RIS code</th><th style="width: 200px">Responsibility center code</th><th style="width: 160px">APP-CSE sheet</th><th style="width: 150px">Uses APP-CSE of</th><th>Can request supplies</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _offices.Page(_pOffices))
                        {
                            var row = _officeEdits[o.OfficeId];
                            <tr @key="o.OfficeId">
                                <td><span class="cell-strong">@o.OfficeAcronym</span><span class="cell-sub">@o.OfficeName</span></td>
                                <td><input class="form-control form-control-sm" maxlength="5" inputmode="numeric" autocomplete="off" placeholder="—" aria-label="@($"RIS code of {o.OfficeAcronym}")" @bind="row.Code" /></td>
                                <td><input class="form-control form-control-sm" maxlength="30" autocomplete="off" aria-label="@($"Responsibility center code of {o.OfficeAcronym}")" @bind="row.Rc" /></td>
                                <td><input class="form-control form-control-sm" maxlength="50" autocomplete="off" placeholder="@o.OfficeAcronym" aria-label="@($"APP-CSE sheet name of {o.OfficeAcronym}")" @bind="row.Sheet" /></td>
                                <td>
                                    <select class="form-select form-select-sm" aria-label="@($"Whose APP-CSE {o.OfficeAcronym} uses")" @bind="row.AppCseOf">
                                        <option value="0">Its own</option>
                                        @foreach (var other in _offices.Where(x => x.OfficeId != o.OfficeId && x.AppCseOfficeId == null))
                                        {
                                            <option value="@other.OfficeId">@other.OfficeAcronym</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="@($"can-{o.OfficeId}")" @bind="row.Can" />
                                        <label class="form-check-label small" for="@($"can-{o.OfficeId}")">@(row.Can ? "Yes" : "No")</label>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (row.Rc != (o.ResponsibilityCenterCode ?? "") || row.Can != o.CanRequisition || row.Sheet != (o.AppCseSheet ?? "") || row.Code != (o.RisCode ?? "") || row.AppCseOf != (o.AppCseOfficeId ?? 0))
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SaveOfficeAsync(o, row)">Save</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="_offices.Count" @bind-Page="_pOffices" Label="Office pages" />
        </section>
    }
</div>

@code {
    private int _pOffices = 1;
    private sealed class OfficeEdit { public string Rc { get; set; } = ""; public bool Can { get; set; } public string Sheet { get; set; } = ""; public string Code { get; set; } = ""; public int AppCseOf { get; set; } }

    private sealed record SeasonOption(string Code, string Name, string Note, string Icon);
    private static readonly IReadOnlyList<SeasonOption> SeasonOptions =
    [
        new("off", "Off", "Standard DepEd NCR blue", "bi-circle"),
        new("auto", "Automatic", "Follows the calendar", "bi-calendar2-heart"),
        .. Seasons.All.Select(s => new SeasonOption(s.Code, s.Name, s.When, s.Icon)),
    ];
    private string _season = "off";
    private bool _seasonSaving;
    private bool _appCseRequired = true;
    private bool _appCseSaving;
    // This is bumped to redraw the switch so it goes back to the saved value after Cancel or a failed save
    private int _appCseKey;

    private SettingsForm? _form;
    private List<Office> _offices = [];
    private Dictionary<int, OfficeEdit> _officeEdits = new();
    private List<RoPersonnel> _people = [];
    private bool _saving;
    private uint _userId;

    private IReadOnlyList<PickOption<int>> PeopleOptions(string first) =>
        [new(0, first), .. _people.Select(p => new PickOption<int>(p.PersonnelId, p.FullName, p.Position))];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
        await using (var db = await DbFactory.CreateDbContextAsync())
            _people = await db.RoPersonnel.AsNoTracking().OrderBy(p => p.FullName).ToListAsync();
        await LoadOfficesAsync();
        _form = await SettingsSvc.LoadAsync();
        _season = await SettingsSvc.SeasonAsync();
        _appCseRequired = await SettingsSvc.RequireAppCseAsync();
    }

    private async Task SetSeasonAsync(SeasonOption opt)
    {
        if (opt.Code == _season) return;
        var ok = await Modal.ConfirmAsync(opt.Code == "off" ? "Turn off the seasonal theme?" : $"Use the {opt.Name} theme?",
            opt.Code == "off" ? "e-PINS and e-SRS go back to the standard DepEd NCR blue for everyone."
                : opt.Code == "auto" ? "The theme will change by itself through the year, for everyone using e-PINS and e-SRS."
                : $"Everyone using e-PINS and e-SRS will see it on the top bar, the page headers and the sidebar.",
            opt.Code == "off" ? "Turn off" : "Use this theme", "Cancel", ModalVariant.Info);
        if (!ok) return;
        _seasonSaving = true;
        try
        {
            var r = await SettingsSvc.SaveSeasonAsync(opt.Code, _userId);
            if (!r.Ok) { await Modal.WarningAsync("Couldn't save", r.Message); return; }
            _season = opt.Code;
            Season.Remember(opt.Code);
            await JS.InvokeVoidAsync("amsSeason.set", Seasons.Resolve(opt.Code, PhTime.Now));   // this page changes now, the others within a few seconds
            await JS.InvokeVoidAsync("showToast", r.Message, "success");
        }
        finally { _seasonSaving = false; }
    }

    private async Task ToggleAppCseAsync(ChangeEventArgs e)
    {
        var want = e.Value is true;
        if (want == _appCseRequired) return;
        var ok = await Modal.ConfirmAsync(
            want ? "Require APP-CSE again?" : "Turn off the APP-CSE requirement?",
            want ? "Offices will only be able to request items in their APP-CSE, within their balance."
                 : "Offices will be able to request any catalog item in any quantity, even items not in their APP-CSE. AMS still checks warehouse stock when approving.",
            want ? "Require APP-CSE" : "Turn it off", "Cancel", want ? ModalVariant.Info : ModalVariant.Warning);
        // This is the Cancel part: the browser already flipped the switch, so redraw it from the saved value
        if (!ok) { _appCseKey++; return; }
        _appCseSaving = true;
        try
        {
            var r = await SettingsSvc.SaveRequireAppCseAsync(want, _userId);
            if (!r.Ok) { _appCseKey++; await Modal.WarningAsync("Couldn't save", r.Message); return; }
            _appCseRequired = want;
            await JS.InvokeVoidAsync("showToast", r.Message, "success");
        }
        finally { _appCseSaving = false; }
    }

    private async Task LoadOfficesAsync()
    {
        _offices = await SettingsSvc.OfficesAsync();
        _officeEdits = _offices.ToDictionary(o => o.OfficeId, o => new OfficeEdit { Rc = o.ResponsibilityCenterCode ?? "", Can = o.CanRequisition, Sheet = o.AppCseSheet ?? "", Code = o.RisCode ?? "", AppCseOf = o.AppCseOfficeId ?? 0 });
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        var ok = await Modal.ConfirmAsync("Save these settings?",
            "New requisitions will use this Entity Name, Fund Cluster and these default signatories.",
            "Save settings", "Cancel", ModalVariant.Info);
        if (!ok) return;
        _saving = true;
        try
        {
            var r = await SettingsSvc.SaveAsync(_form, _userId);
            if (!r.Ok) { await Modal.WarningAsync("Couldn't save", r.Message); return; }
            await JS.InvokeVoidAsync("showToast", r.Message, "success");
        }
        finally { _saving = false; }
    }

    private async Task SaveOfficeAsync(Office o, OfficeEdit row)
    {
        if (!row.Can && o.CanRequisition)
        {
            var ok = await Modal.ConfirmAsync($"Stop {o.OfficeAcronym} from requesting supplies?",
                "Its account can still log in, but it won't be able to submit requisitions.", "Save", "Cancel", ModalVariant.Warning);
            if (!ok) return;
        }
        var r = await SettingsSvc.SaveOfficeAsync(o.OfficeId, row.Rc, row.Can, row.Sheet, row.Code, row.AppCseOf, _userId);
        if (!r.Ok) { await Modal.WarningAsync("Couldn't save", r.Message); return; }
        await LoadOfficesAsync();
        await JS.InvokeVoidAsync("showToast", r.Message, "success");
    }
}
