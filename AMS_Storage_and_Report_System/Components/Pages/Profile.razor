@page "/profile"
@layout AppLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ProfilePictureStorage Pictures
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Profile> Log

<PageTitle>My profile | AMS StockWatch</PageTitle>

<PageHeader Title="My profile" Subtitle="Your name, picture and password." />

<div class="wrap page-body">
    @if (_user is null)
    {
        <div class="panel"><div class="loading">Loading your profile…</div></div>
    }
    else
    {
        @if (_user.RequirePasswordChange)
        {
            <div class="callout" role="alert">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                <div>
                    <p><strong>Choose your own password to continue.</strong> You're using a temporary password set by a Super Admin.</p>
                    <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="OpenPassword">Change password</button>
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-4">
                <section class="panel h-100">
                    <div class="panel-body text-center">
                        <span class="avatar mx-auto" style="width:112px;height:112px;font-size:2.5rem">
                            @if (Pictures.GetProfilePictureUrl(_user.ProfilePicturePath) is { } pic) { <img src="@pic" alt="Your profile picture" /> }
                            else { @Initial }
                        </span>
                        <h2 class="h5 fw-bold mt-3 mb-1">@_user.Name</h2>
                        <p class="text-muted-2 mb-3">@(_user.Role == UserRole.SuperAdmin ? "Super Admin" : "Admin"), Asset Management Section</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenPicture">
                            <i class="bi bi-camera me-1" aria-hidden="true"></i> Change picture
                        </button>
                    </div>
                </section>
            </div>

            <div class="col-lg-8">
                <section class="panel">
                    <header class="panel-head">
                        <h2>Account details</h2>
                        @if (!_editing)
                        {
                            <button type="button" class="act" @onclick="StartEdit"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</button>
                        }
                    </header>
                    <div class="panel-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="p-display">Display name</label>
                                <input id="p-display" class="form-control" autocomplete="off" maxlength="100"
                                       @bind="_displayName" readonly="@(!_editing)" />
                                <div class="form-text">Shown in the menu and on activity logs.</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="p-email">Email</label>
                                <input id="p-email" type="email" class="form-control" autocomplete="off" maxlength="100"
                                       @bind="_email" readonly="@(!_editing)" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="p-full">Full name</label>
                                <input id="p-full" class="form-control" value="@_user.FullName" readonly />
                                <div class="form-text">Ask a Super Admin to correct your full name.</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="p-user">Username</label>
                                <input id="p-user" class="form-control" value="@_user.Username" readonly />
                            </div>
                        </div>

                        @if (_formError is not null)
                        {
                            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_formError</div>
                        }

                        @if (_editing)
                        {
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-light" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
                                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                                    @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                                    Save changes
                                </button>
                            </div>
                        }
                    </div>
                </section>

                <section class="panel">
                    <header class="panel-head"><h2>Security</h2></header>
                    <div class="panel-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <p class="mb-1 fw-semibold">Password</p>
                            <p class="mb-0 text-muted-2 small">
                                @(_user.LastLoginAt is { } l ? $"Last sign-in {l:MMMM d, yyyy 'at' h:mm tt}." : "")
                            </p>
                        </div>
                        <button type="button" class="btn btn-outline-primary" @onclick="OpenPassword">
                            <i class="bi bi-key me-1" aria-hidden="true"></i> Change password
                        </button>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

<Dialog Show="_passwordOpen" Title="Change password" Icon="bi-key" Busy="_saving" OnClose="ClosePassword">
    <ChildContent>
        <div class="field">
            <label class="form-label" for="c-current">Current password</label>
            <input id="c-current" class="form-control" type="@(_showPasswords ? "text" : "password")" autocomplete="off" @bind="_current" />
        </div>
        <div class="field">
            <label class="form-label" for="c-new">New password</label>
            <input id="c-new" class="form-control" type="@(_showPasswords ? "text" : "password")" autocomplete="off" @bind="_new" @bind:event="oninput" />
            <div class="form-text @(_new.Length > 0 && !StrongEnough(_new) ? "text-danger" : "")">At least 8 characters, with letters and numbers.</div>
        </div>
        <div class="field">
            <label class="form-label" for="c-confirm">Type the new password again</label>
            <input id="c-confirm" class="form-control" type="@(_showPasswords ? "text" : "password")" autocomplete="off" @bind="_confirm" @bind:event="oninput" />
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="c-show" @bind="_showPasswords" />
            <label class="form-check-label" for="c-show">Show passwords</label>
        </div>
        @if (_passwordError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_passwordError</div>
        }
    </ChildContent>
    <Footer>
        @if (!(_user?.RequirePasswordChange ?? false))
        {
            <button type="button" class="btn btn-light" @onclick="ClosePassword" disabled="@_saving">Cancel</button>
        }
        <button type="button" class="btn btn-primary" @onclick="ChangePasswordAsync" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            Change password
        </button>
    </Footer>
</Dialog>

<Dialog Show="_pictureOpen" Title="Profile picture" Icon="bi-camera" Busy="_saving" OnClose="() => _pictureOpen = false">
    <ChildContent>
        <label class="form-label" for="pic-file">Choose an image</label>
        <InputFile id="pic-file" class="form-control" OnChange="OnPictureSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
        <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. A square photo of your face works best.</div>
        @if (_pictureError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_pictureError</div>
        }
    </ChildContent>
    <Footer>
        @if (!string.IsNullOrEmpty(_user?.ProfilePicturePath))
        {
            <button type="button" class="btn btn-light text-danger me-auto" @onclick="RemovePictureAsync" disabled="@_saving">Remove picture</button>
        }
        <button type="button" class="btn btn-light" @onclick="() => _pictureOpen = false" disabled="@_saving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="UploadPictureAsync" disabled="@(_saving || _picture is null)">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            Save picture
        </button>
    </Footer>
</Dialog>

@code {
    [SupplyParameterFromQuery(Name = "requirePasswordChange")] public bool RequirePasswordChange { get; set; }
    [SupplyParameterFromQuery(Name = "passwordChanged")] public bool PasswordChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && PasswordChanged)
            await JS.InvokeVoidAsync("showToast", "Password changed. Other devices signed in with the old password will be signed out.", "success");
    }

    private const long MaxPictureBytes = 5 * 1024 * 1024;
    private static readonly string[] PictureTypes = ["image/jpeg", "image/png", "image/gif", "image/webp"];

    private User? _user;
    private bool _editing, _saving;
    private string _displayName = "", _email = "";
    private string? _formError;

    private bool _passwordOpen, _showPasswords;
    private string _current = "", _new = "", _confirm = "";
    private string? _passwordError;

    private bool _pictureOpen;
    private IBrowserFile? _picture;
    private string? _pictureError;

    private string Initial => string.IsNullOrWhiteSpace(_user?.Name) ? "?" : _user!.Name.Trim()[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_user?.RequirePasswordChange == true) OpenPassword();
    }

    private async Task LoadAsync()
    {
        var username = (await AuthStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name;
        if (username is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        _user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Username == username);
        _displayName = _user?.Name ?? "";
        _email = _user?.Email ?? "";
    }

    // Re-issue the sign-in cookie so the menu shows the new name/picture.
    private void RefreshSession(string returnUrl = "/profile") =>
        Navigation.NavigateTo($"/account/refresh-session?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);

    // ── Details ─────────────────────────────────────────────────────────
    private void StartEdit() { _editing = true; _formError = null; }

    private void CancelEdit()
    {
        _editing = false; _formError = null;
        _displayName = _user?.Name ?? ""; _email = _user?.Email ?? "";
    }

    private async Task SaveAsync()
    {
        if (_user is null) return;
        _formError = string.IsNullOrWhiteSpace(_displayName) ? "Enter a display name."
                   : !_email.Contains('@') || !_email.Contains('.') ? "Enter a valid email address."
                   : null;
        if (_formError is not null) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var email = _email.Trim();
            if (await db.Users.AnyAsync(u => u.Email == email && u.UserId != _user.UserId))
            {
                _formError = "Another account already uses that email.";
                return;
            }
            var u = await db.Users.FindAsync(_user.UserId);
            if (u is null) return;
            u.DisplayName = _displayName.Trim();
            u.Email = email;
            u.UpdatedAt = PhTime.Now;
            await db.SaveChangesAsync();
            RefreshSession();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving profile failed");
            _formError = "Your changes couldn't be saved. Check your connection and try again.";
        }
        finally { _saving = false; }
    }

    // ── Password ────────────────────────────────────────────────────────
    private static bool StrongEnough(string p) => p.Length >= 8 && p.Any(char.IsLetter) && p.Any(char.IsDigit);

    private void OpenPassword()
    {
        _current = _new = _confirm = "";
        _passwordError = null;
        _showPasswords = false;
        _passwordOpen = true;
    }

    private void ClosePassword()
    {
        if (_user?.RequirePasswordChange == true) return;   // must finish this first
        _passwordOpen = false;
    }

    private async Task ChangePasswordAsync()
    {
        if (_user is null) return;
        _passwordError = string.IsNullOrEmpty(_current) ? "Enter your current password."
                       : !StrongEnough(_new) ? "The new password needs at least 8 characters, with letters and numbers."
                       : _new != _confirm ? "The two new passwords don't match."
                       : _new == _current ? "Choose a password different from the current one."
                       : null;
        if (_passwordError is not null) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(_user.UserId);
            if (u is null) return;
            if (!BCrypt.Net.BCrypt.Verify(_current, u.PasswordHash))
            {
                _passwordError = "Your current password is incorrect.";
                return;
            }
            var wasRequired = u.RequirePasswordChange;
            u.PasswordHash = BCrypt.Net.BCrypt.HashPassword(_new, 12);
            u.RequirePasswordChange = false;
            u.UpdatedAt = PhTime.Now;
            db.UserActivities.Add(new UserActivity { UserId = u.UserId, ActivityType = "Update", Description = "Changed own password", CreatedAt = PhTime.Now });
            await db.SaveChangesAsync();

            _passwordOpen = false;
            // Always re-issue the sign-in cookie: it carries a fingerprint of the password,
            // and other sessions using the old password are signed out within 5 minutes.
            RefreshSession(wasRequired ? "/dashboard" : "/profile?passwordChanged=true");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Password change failed");
            _passwordError = "The password couldn't be changed. Check your connection and try again.";
        }
        finally { _saving = false; }
    }

    // ── Picture ─────────────────────────────────────────────────────────
    private void OpenPicture() { _picture = null; _pictureError = null; _pictureOpen = true; }

    private void OnPictureSelected(InputFileChangeEventArgs e)
    {
        _pictureError = null;
        _picture = null;
        if (!PictureTypes.Contains(e.File.ContentType)) _pictureError = "Choose a JPG, PNG, GIF or WebP image.";
        else if (e.File.Size > MaxPictureBytes) _pictureError = "The image is larger than 5 MB.";
        else _picture = e.File;
    }

    private async Task UploadPictureAsync()
    {
        if (_user is null || _picture is null) return;
        _saving = true;
        try
        {
            string fileName;
            await using (var stream = _picture.OpenReadStream(MaxPictureBytes))
                fileName = await Pictures.SaveProfilePictureAsync(stream, _user.UserId, Path.GetExtension(_picture.Name));

            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(_user.UserId);
            if (u is null) return;
            var old = u.ProfilePicturePath;
            u.ProfilePicturePath = fileName;
            u.UpdatedAt = PhTime.Now;
            await db.SaveChangesAsync();
            Pictures.DeleteProfilePicture(old);   // only after the new one is saved
            RefreshSession();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Picture upload failed");
            _pictureError = "The picture couldn't be saved. Try again.";
        }
        finally { _saving = false; }
    }

    private async Task RemovePictureAsync()
    {
        if (_user is null) return;
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(_user.UserId);
            if (u is null) return;
            var old = u.ProfilePicturePath;
            u.ProfilePicturePath = null;
            u.UpdatedAt = PhTime.Now;
            await db.SaveChangesAsync();
            Pictures.DeleteProfilePicture(old);
            RefreshSession();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Removing picture failed");
            _pictureError = "The picture couldn't be removed. Try again.";
        }
        finally { _saving = false; }
    }
}
