@page "/profile"
@layout AppLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.EntityFrameworkCore
@using AMS_Storage_and_Report_System.Data
@using AMS_Storage_and_Report_System.Models
@using AMS_Storage_and_Report_System.Services
@using System.Security.Claims
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject ProfilePictureStorage ProfileStorage
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Profile — StockWatch</PageTitle>

@if (currentUser?.RequirePasswordChange == true)
{
    <div class="password-required-banner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <div>
            <strong>Password Change Required</strong>
            <p>Your administrator has requested that you change your password. Please update your password to continue.</p>
        </div>
    </div>
}

<div class="profile-header">
    <h1 class="page-title">Profile</h1>
</div>

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-picture-section">
            <div class="profile-picture-wrapper">
                @if (!string.IsNullOrEmpty(currentUser?.ProfilePicturePath))
                {
                    <img src="@ProfileStorage.GetProfilePictureUrl(currentUser.ProfilePicturePath)"
                         alt="Profile Picture"
                         class="profile-picture" />
                }
                else
                {
                    <div class="profile-picture-placeholder">
                        @GetInitial(GetDisplayName())
                    </div>
                }
                <button class="change-picture-btn" @onclick="() => showPictureModal = true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    Change Picture
                </button>
            </div>
        </div>

        <div class="profile-info-section">
            <div class="info-group">
                <label class="info-label">Full Name</label>
                <div class="info-value">@currentUser?.FullName</div>
                <p class="info-hint">Your full name cannot be changed from this page.</p>
            </div>

            <div class="info-group">
                <label class="info-label">Display Name</label>
                @if (isEditingProfile)
                {
                    <input type="text"
                           class="info-input"
                           @bind="displayNameInput"
                           placeholder="Enter display name" />
                }
                else
                {
                    <div class="info-value">@GetDisplayName()</div>
                }
                <p class="info-hint">This is how your name appears in the app.</p>
            </div>

            <div class="info-group">
                <label class="info-label">Email</label>
                @if (isEditingProfile)
                {
                    <input type="email"
                           class="info-input"
                           @bind="emailInput"
                           placeholder="Enter email" />
                }
                else
                {
                    <div class="info-value">@currentUser?.Email</div>
                }
            </div>

            <div class="info-group">
                <label class="info-label">Username</label>
                <div class="info-value">@currentUser?.Username</div>
            </div>

            <div class="info-group">
                <label class="info-label">Role</label>
                <div class="info-value role-badge">@currentUser?.Role.ToString()</div>
            </div>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="form-error">@formError</div>
            }

            <div class="profile-actions">
                @if (isEditingProfile)
                {
                    <button class="btn-ghost" @onclick="CancelEditProfile">Cancel</button>
                    <button class="btn-primary" @onclick="SaveProfile" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                }
                else
                {
                    <button class="btn-primary" @onclick="EditProfile">Edit Profile</button>
                }
            </div>

            <div class="password-section">
                <h3 class="section-title">Security</h3>
                <button class="btn-change-password" @onclick="() => showPasswordModal = true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Change Password
                </button>
            </div>
        </div>
    </div>
</div>

@if (showPasswordModal)
{
    <div class="modal-backdrop" @onclick="ClosePasswordModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="modal-title">Change Password</h2>

            <div class="field">
                <label>Current Password:</label>
                <div class="password-input-group">
                    <input type="@(showCurrentPassword ? "text" : "password")"
                           @bind="currentPassword"
                           placeholder="Enter current password" />
                    <button type="button" class="btn-icon" @onclick="() => showCurrentPassword = !showCurrentPassword">
                        @if (showCurrentPassword)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <div class="field">
                <label>New Password:</label>
                <div class="password-input-group">
                    <input type="@(showNewPassword ? "text" : "password")"
                           @bind="newPassword"
                           placeholder="Enter new password" />
                    <button type="button" class="btn-icon" @onclick="() => showNewPassword = !showNewPassword">
                        @if (showNewPassword)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
                <p class="field-hint">Minimum 8 characters with letters, numbers, and special characters.</p>
            </div>

            <div class="field">
                <label>Confirm New Password:</label>
                <div class="password-input-group">
                    <input type="@(showConfirmPassword ? "text" : "password")"
                           @bind="confirmPassword"
                           placeholder="Confirm new password" />
                    <button type="button" class="btn-icon" @onclick="() => showConfirmPassword = !showConfirmPassword">
                        @if (showConfirmPassword)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(passwordError))
            {
                <div class="form-error">@passwordError</div>
            }

            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ClosePasswordModal">Cancel</button>
                <button class="btn-primary" @onclick="ChangePassword" disabled="@isChangingPassword">
                    @(isChangingPassword ? "Changing..." : "Change Password")
                </button>
            </div>
        </div>
    </div>
}

@if (showPictureModal)
{
    <div class="modal-backdrop" @onclick="ClosePictureModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="modal-title">Change Profile Picture</h2>

            <div class="upload-zone" @ondragover:preventDefault @ondrop:preventDefault @ondrop="OnFileDrop">
                <svg class="upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p class="upload-text">Drag and drop an image or click to browse</p>
                <InputFile OnChange="OnFileSelected" accept="image/*" class="file-input" />
                <button class="btn-upload" onclick="this.previousElementSibling.click(); return false;">
                    Browse Files
                </button>
            </div>

            @if (selectedFileName != null)
            {
                <div class="selected-file">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                        <polyline points="13 2 13 9 20 9"></polyline>
                    </svg>
                    <span>@selectedFileName</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="upload-error">@uploadError</div>
            }

            <div class="modal-actions">
                <button class="btn-ghost" @onclick="ClosePictureModal">Cancel</button>
                <button class="btn-primary" @onclick="UploadProfilePicture" disabled="@(selectedFile == null || isUploading)">
                    @(isUploading ? "Uploading..." : "Upload")
                </button>
                @if (!string.IsNullOrEmpty(currentUser?.ProfilePicturePath))
                {
                    <button class="btn-danger" @onclick="RemoveProfilePicture" disabled="@isUploading">
                        Remove Picture
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public bool RequirePasswordChange { get; set; }

    private User? currentUser;
    private bool isEditingProfile = false;
    private string displayNameInput = "";
    private string emailInput = "";
    private bool isSaving = false;
    private string formError = "";

    private bool showPictureModal = false;
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private bool isUploading = false;
    private string uploadError = "";

    private bool showPasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private string passwordError = "";
    private bool isChangingPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();

        // If password change is required, open the modal automatically
        if (RequirePasswordChange && currentUser?.RequirePasswordChange == true)
        {
            showPasswordModal = true;
        }
    }

    private async Task LoadCurrentUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (username != null)
        {
            currentUser = await Db.Users.FirstOrDefaultAsync(u => u.Username == username);
        }
    }

    private string GetDisplayName()
    {
        if (currentUser == null) return "Unknown";
        return string.IsNullOrWhiteSpace(currentUser.DisplayName)
            ? currentUser.FullName
            : currentUser.DisplayName;
    }

    private string GetInitial(string name)
    {
        return string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();
    }

    private void EditProfile()
    {
        displayNameInput = currentUser?.DisplayName ?? currentUser?.FullName ?? "";
        emailInput = currentUser?.Email ?? "";
        isEditingProfile = true;
        formError = "";
    }

    private void CancelEditProfile()
    {
        isEditingProfile = false;
        displayNameInput = "";
        emailInput = "";
        formError = "";
    }

    private async Task SaveProfile()
    {
        if (currentUser == null) return;

        formError = "";

        if (string.IsNullOrWhiteSpace(displayNameInput))
        {
            formError = "Display name cannot be empty.";
            return;
        }

        if (string.IsNullOrWhiteSpace(emailInput))
        {
            formError = "Email cannot be empty.";
            return;
        }

        // Basic email validation
        if (!emailInput.Contains("@") || !emailInput.Contains("."))
        {
            formError = "Please enter a valid email address.";
            return;
        }

        isSaving = true;

        try
        {
            currentUser.DisplayName = displayNameInput.Trim();
            currentUser.Email = emailInput.Trim();
            currentUser.UpdatedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            isEditingProfile = false;
            await ShowToast("Profile updated successfully. Refreshing...");

            // Wait a moment for the toast to show, then redirect to logout and back
            await Task.Delay(500);
            Navigation.NavigateTo("/account/refresh-session?returnUrl=/profile", forceLoad: true);
        }
        catch (Exception ex)
        {
            formError = "Failed to update profile: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateAuthenticationClaims()
    {
        // This method is no longer needed but kept for profile picture updates
        // We'll use the session refresh endpoint instead
        if (currentUser == null || HttpContextAccessor.HttpContext == null) return;

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, currentUser.UserId.ToString()),
            new(ClaimTypes.Name, currentUser.Username),
            new(ClaimTypes.Role, currentUser.Role.ToString()),
            new("FullName", currentUser.FullName),
            new("DisplayName", currentUser.DisplayName ?? ""),
            new("ProfilePicture", currentUser.ProfilePicturePath ?? "")
        };

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await HttpContextAccessor.HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties
            {
                IsPersistent = HttpContextAccessor.HttpContext.User.Identities.FirstOrDefault()?.AuthenticationType == CookieAuthenticationDefaults.AuthenticationScheme,
                ExpiresUtc = DateTimeOffset.UtcNow.AddHours(8)
            });
    }

    private void ClosePictureModal()
    {
        showPictureModal = false;
        selectedFile = null;
        selectedFileName = null;
        uploadError = "";
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        uploadError = "";
    }

    private async Task OnFileDrop(DragEventArgs e)
    {
        // File drop handling would require JS interop for full implementation
        // For now, users can click to browse
    }

    private async Task UploadProfilePicture()
    {
        if (selectedFile == null || currentUser == null) return;

        uploadError = "";
        isUploading = true;

        try
        {
            // Validate file type
            var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(selectedFile.ContentType))
            {
                uploadError = "Please upload a valid image file (JPEG, PNG, GIF, or WebP).";
                return;
            }

            // Validate file size (5MB max)
            const long maxFileSize = 5 * 1024 * 1024;
            if (selectedFile.Size > maxFileSize)
            {
                uploadError = "File size must be less than 5MB.";
                return;
            }

            // Delete old profile picture if exists
            if (!string.IsNullOrEmpty(currentUser.ProfilePicturePath))
            {
                ProfileStorage.DeleteProfilePicture(currentUser.ProfilePicturePath);
            }

            // Save new profile picture
            var extension = Path.GetExtension(selectedFile.Name);
            using var stream = selectedFile.OpenReadStream(maxFileSize);
            var fileName = await ProfileStorage.SaveProfilePictureAsync(stream, currentUser.UserId, extension);

            // Update user record
            currentUser.ProfilePicturePath = fileName;
            currentUser.UpdatedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            await ShowToast("Profile picture updated successfully. Refreshing...");
            ClosePictureModal();

            // Wait a moment for the toast to show, then refresh session
            await Task.Delay(500);
            Navigation.NavigateTo("/account/refresh-session?returnUrl=/profile", forceLoad: true);
        }
        catch (Exception ex)
        {
            uploadError = "Failed to upload profile picture: " + ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task RemoveProfilePicture()
    {
        if (currentUser == null) return;

        isUploading = true;

        try
        {
            if (!string.IsNullOrEmpty(currentUser.ProfilePicturePath))
            {
                ProfileStorage.DeleteProfilePicture(currentUser.ProfilePicturePath);
                currentUser.ProfilePicturePath = null;
                currentUser.UpdatedAt = DateTime.UtcNow;
                await Db.SaveChangesAsync();
            }

            await ShowToast("Profile picture removed. Refreshing...", "danger");
            ClosePictureModal();

            // Wait a moment for the toast to show, then refresh session
            await Task.Delay(500);
            Navigation.NavigateTo("/account/refresh-session?returnUrl=/profile", forceLoad: true);
        }
        catch (Exception ex)
        {
            uploadError = "Failed to remove profile picture: " + ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task ShowToast(string text, string type = "success")
    {
        await JS.InvokeVoidAsync("showToast", text, type);
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        showCurrentPassword = false;
        showNewPassword = false;
        showConfirmPassword = false;
        passwordError = "";
    }

    private async Task ChangePassword()
    {
        if (currentUser == null) return;

        passwordError = "";

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            passwordError = "Please enter your current password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            passwordError = "Please enter a new password.";
            return;
        }

        if (newPassword.Length < 8)
        {
            passwordError = "New password must be at least 8 characters long.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            passwordError = "New passwords do not match.";
            return;
        }

        if (currentPassword == newPassword)
        {
            passwordError = "New password must be different from current password.";
            return;
        }

        isChangingPassword = true;

        try
        {
            // Verify current password
            bool passwordValid = BCrypt.Net.BCrypt.Verify(currentPassword, currentUser.PasswordHash);

            if (!passwordValid)
            {
                passwordError = "Current password is incorrect.";
                return;
            }

            // Update password
            currentUser.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPassword);
            currentUser.RequirePasswordChange = false; // Clear the flag after successful change
            currentUser.UpdatedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            await ShowToast("Password changed successfully.");
            ClosePasswordModal();
        }
        catch (Exception ex)
        {
            passwordError = "Failed to change password: " + ex.Message;
        }
        finally
        {
            isChangingPassword = false;
        }
    }
}
