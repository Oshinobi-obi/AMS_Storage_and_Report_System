@page "/login"
@layout EmptyLayout
@inject AntiforgeryStateProvider AntiforgeryStateProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign in | AMS StockWatch</PageTitle>

<div class="auth-page">
    <div class="wrap">
        <header class="auth-top">
            <span class="brand-pill">
                <img src="images/one-ncr-stronger-together.png" alt="DepEd NCR, One NCR Stronger Together" width="119" height="38" />
            </span>
        </header>
    </div>

    <main class="auth-main">
        <div class="wrap">
            <div class="login-card">
                <img class="login-seal" src="images/deped-ncr-seal.png" alt="" width="72" height="72" />
                <h1>Sign in to AMS StockWatch</h1>
                <p class="login-sub">For Asset Management Section staff</p>

                @if (SignedOut)
                {
                    <div class="callout py-2"><i class="bi bi-check-circle" aria-hidden="true"></i><p>You've been logged out.</p></div>
                }
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="callout is-bad py-2" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><p>@Error</p></div>
                }

                <form method="post" action="/account/login" autocomplete="off">
                    <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryStateProvider.GetAntiforgeryToken()?.Value" />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control form-control-lg" type="text" id="username" name="username"
                               autocomplete="off" autocapitalize="off" spellcheck="false" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <div class="password-group">
                            <input class="form-control form-control-lg" type="@(_showPassword ? "text" : "password")"
                                   id="password" name="password" autocomplete="off" required />
                            <button type="button" class="btn-icon" @onclick="() => _showPassword = !_showPassword"
                                    aria-label="@(_showPassword ? "Hide password" : "Show password")">
                                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                        <label class="form-check-label" for="rememberMe">Keep me signed in on this computer for 7 days</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
                </form>

                <p class="small text-muted-2 text-center mt-3 mb-0">Forgot your password? Ask a Super Admin to reset it.</p>
            </div>
        </div>
    </main>

    <footer class="auth-foot">
        <div class="wrap">&copy; @PhTime.Now.Year Asset Management Section, DepEd NCR</div>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "signedOut")] public bool SignedOut { get; set; }

    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                ? ReturnUrl : "/dashboard";
            Navigation.NavigateTo(target, forceLoad: true);
        }
    }
}
