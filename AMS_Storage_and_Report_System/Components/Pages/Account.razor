@page "/account"
@layout AppLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using AMS_Storage_and_Report_System.Data
@using AMS_Storage_and_Report_System.Models
@using AMS_Storage_and_Report_System.Services
@using AMS_Storage_and_Report_System.Components.Shared
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Account Management — StockWatch</PageTitle>

<div class="account-header">
    <h1 class="page-title">Account Management</h1>
    @if (isSuperAdmin)
    {
        <button class="btn-primary" @onclick="OpenAddUserModal">Add User +</button>
    }
</div>

@if (!isSuperAdmin)
{
    <AccessDeniedModal Show="true"
                       Message="You currently have no access to this page. Only Super Admins can manage user accounts."
                       RedirectUrl="/dashboard" />
}
else
{
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-value">@totalUsers</div>
            <div class="stat-label">Total Users</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@onlineUsers</div>
            <div class="stat-label">Online Now</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@superAdminCount</div>
            <div class="stat-label">Super Admins</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@adminCount</div>
            <div class="stat-label">Admins</div>
        </div>
    </div>

    <div class="users-card">
        <div class="users-table">
            <div class="users-row users-header">
                <div>User</div>
                <div>Role</div>
                <div>Status</div>
                <div>Last Login</div>
                <div>Created</div>
                <div>Actions</div>
            </div>
            @foreach (var user in users)
            {
                <div class="users-row @(!user.IsActive ? "user-deactivated" : "")">
                    <div class="user-cell">
                        <div class="user-info">
                            @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                            {
                                <img src="/api/profile-picture/@user.ProfilePicturePath" alt="Avatar" class="user-avatar" />
                            }
                            else
                            {
                                <div class="user-avatar-placeholder">
                                    @GetInitial(user.DisplayName ?? user.FullName)
                                </div>
                            }
                            <div>
                                <div class="user-name">@(string.IsNullOrWhiteSpace(user.DisplayName) ? user.FullName : user.DisplayName)</div>
                                <div class="user-email">@user.Email</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="role-badge role-@user.Role.ToString().ToLower()">@user.Role</span>
                    </div>
                    <div>
                        @if (IsUserOnline(user))
                        {
                            <span class="status-badge status-online">Online</span>
                        }
                        else if (user.IsActive)
                        {
                            <span class="status-badge status-offline">Offline</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactive</span>
                        }
                    </div>
                    <div class="date-cell">
                        @if (user.LastLoginAt.HasValue)
                        {
                            var localTime = user.LastLoginAt.Value.ToLocalTime();
                            <div>@localTime.ToString("MMM dd, yyyy")</div>
                            <div class="time-text">@localTime.ToString("hh:mm tt")</div>
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </div>
                    <div class="date-cell">
                        @{
                            var createdLocal = user.CreatedAt.ToLocalTime();
                        }
                        <div>@createdLocal.ToString("MMM dd, yyyy")</div>
                        <div class="time-text">@createdLocal.ToString("hh:mm tt")</div>
                    </div>
                    <div class="row-actions">
                        <button class="action-link view-link" @onclick="() => ViewUserActivity(user.UserId)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            View Activity
                        </button>
                        <button class="action-link password-link" @onclick="() => OpenResetPasswordModal(user)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            Reset Password
                        </button>
                        @if (user.UserId != currentUserId)
                        {
                            @if (user.IsActive)
                            {
                                <button class="action-link danger-link" @onclick="() => OpenDeactivateModal(user)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <span>Deactivate</span>
                                </button>
                            }
                            else
                            {
                                <button class="action-link success-link" @onclick="() => OpenReactivateModal(user)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                                    </svg>
                                    <span>Re-enable</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (showActivityModal && selectedUserActivities != null)
    {
        <div class="modal-backdrop" @onclick="CloseActivityModal">
            <div class="modal-card activity-modal" @onclick:stopPropagation="true">
                <h2 class="modal-title">User Activity</h2>
                <div class="activity-user-info">
                    <strong>@selectedUserName</strong>
                </div>

                <div class="activity-list">
                    @if (selectedUserActivities.Count == 0)
                    {
                        <p class="empty-state">No activities recorded yet.</p>
                    }
                    else
                    {
                        @foreach (var activity in selectedUserActivities)
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    @switch (activity.ActivityType)
                                    {
                                        case "Login":
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                                <polyline points="10 17 15 12 10 7"></polyline>
                                                <line x1="15" y1="12" x2="3" y2="12"></line>
                                            </svg>
                                            break;
                                        case "Create":
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                            break;
                                        case "Update":
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"></path>
                                            </svg>
                                            break;
                                        case "Delete":
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                            </svg>
                                            break;
                                        default:
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                            </svg>
                                            break;
                                    }
                                </div>
                                <div class="activity-content">
                                    <div class="activity-type">@activity.ActivityType</div>
                                    <div class="activity-desc">@activity.Description</div>
                                    <div class="activity-meta">
                                        @{
                                            var activityLocalTime = activity.CreatedAt.ToLocalTime();
                                        }
                                        <span>@activityLocalTime.ToString("MMM dd, yyyy hh:mm tt")</span>
                                        @if (!string.IsNullOrEmpty(activity.IpAddress))
                                        {
                                            <span> • IP: @activity.IpAddress</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="CloseActivityModal">Close</button>
                </div>
            </div>
        </div>
    }

    @if (showAddUserModal)
    {
        <div class="modal-backdrop" @onclick="CloseAddUserModal">
            <div class="modal-card" @onclick:stopPropagation="true">
                <h2 class="modal-title">Add New User</h2>

                <div class="field">
                    <label>Full Name:</label>
                    <input type="text" @bind="newUserFullName" placeholder="Enter full name" />
                </div>

                <div class="field">
                    <label>Email:</label>
                    <input type="email" @bind="newUserEmail" placeholder="Enter email address" />
                </div>

                <div class="field">
                    <label>Username:</label>
                    <input type="text" @bind="newUserUsername" placeholder="Enter username" />
                </div>

                <div class="field">
                    <label>Role:</label>
                    <select @bind="newUserRole">
                        <option value="Admin">Admin</option>
                        <option value="SuperAdmin">SuperAdmin</option>
                    </select>
                </div>

                <div class="field">
                    <label>Password:</label>
                    <div class="password-input-group">
                        <input type="@(showPassword ? "text" : "password")"
                               @bind="newUserPassword"
                               placeholder="Enter password or generate one" />
                        <button type="button" class="btn-icon" @onclick="TogglePasswordVisibility">
                            @if (showPassword)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            }
                        </button>
                        <button type="button" class="btn-generate" @onclick="GeneratePassword">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                            </svg>
                            Generate
                        </button>
                    </div>
                    <p class="field-hint">Minimum 8 characters with letters, numbers, and special characters.</p>
                </div>

                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="form-error">@formError</div>
                }

                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="CloseAddUserModal">Cancel</button>
                    <button class="btn-primary" @onclick="CreateUser" disabled="@isSaving">
                        @(isSaving ? "Creating..." : "Create User")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showDeactivateModal && userToToggle != null)
    {
        <div class="modal-backdrop" @onclick="CloseConfirmModal">
            <div class="modal-card confirm-modal" @onclick:stopPropagation="true">
                <div class="confirm-icon warning-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <h2 class="modal-title">Deactivate Account</h2>
                <p class="confirm-message">
                    Are you sure you want to deactivate <strong>@userToToggle.FullName</strong>'s account?
                </p>
                <p class="confirm-hint">The user will no longer be able to log in until their account is re-enabled.</p>
                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="CloseConfirmModal">Cancel</button>
                    <button class="btn-danger" @onclick="ConfirmDeactivate">Deactivate</button>
                </div>
            </div>
        </div>
    }

    @if (showReactivateModal && userToToggle != null)
    {
        <div class="modal-backdrop" @onclick="CloseConfirmModal">
            <div class="modal-card confirm-modal" @onclick:stopPropagation="true">
                <div class="confirm-icon success-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h2 class="modal-title">Re-enable Account</h2>
                <p class="confirm-message">
                    Are you sure you want to re-enable <strong>@userToToggle.FullName</strong>'s account?
                </p>
                <p class="confirm-hint">The user will be able to log in again.</p>
                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="CloseConfirmModal">Cancel</button>
                    <button class="btn-primary" @onclick="ConfirmReactivate">Re-enable</button>
                </div>
            </div>
        </div>
    }

    @if (showResetPasswordModal && userToReset != null)
    {
        <div class="modal-backdrop" @onclick="CloseResetPasswordModal">
            <div class="modal-card" @onclick:stopPropagation="true">
                <h2 class="modal-title">Reset Password for @userToReset.FullName</h2>

                <div class="field">
                    <label>New Password:</label>
                    <div class="password-input-group">
                        <input type="@(showResetPassword ? "text" : "password")"
                               @bind="resetPassword"
                               placeholder="Enter password or generate one" />
                        <button type="button" class="btn-icon" @onclick="() => showResetPassword = !showResetPassword">
                            @if (showResetPassword)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            }
                        </button>
                        <button type="button" class="btn-generate" @onclick="GenerateResetPassword">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                            </svg>
                            Generate
                        </button>
                    </div>
                    <p class="field-hint">Minimum 8 characters. User will be required to change this password on next login.</p>
                </div>

                <div class="field checkbox-field">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="requirePasswordChangeOnReset" />
                        Require password change on next login
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(resetPasswordError))
                {
                    <div class="form-error">@resetPasswordError</div>
                }

                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="CloseResetPasswordModal">Cancel</button>
                    <button class="btn-primary" @onclick="ConfirmResetPassword" disabled="@isResettingPassword">
                        @(isResettingPassword ? "Resetting..." : "Reset Password")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isSuperAdmin = false;
    private uint currentUserId = 0;
    private List<User> users = new();
    private int totalUsers = 0;
    private int onlineUsers = 0;
    private int superAdminCount = 0;
    private int adminCount = 0;

    private bool showActivityModal = false;
    private List<UserActivity>? selectedUserActivities;
    private string selectedUserName = "";

    private bool showAddUserModal = false;
    private string newUserFullName = "";
    private string newUserEmail = "";
    private string newUserUsername = "";
    private string newUserRole = "Admin";
    private string newUserPassword = "";
    private bool showPassword = false;
    private string formError = "";
    private bool isSaving = false;

    private bool showDeactivateModal = false;
    private bool showReactivateModal = false;
    private User? userToToggle;

    private bool showResetPasswordModal = false;
    private User? userToReset;
    private string resetPassword = "";
    private bool showResetPassword = false;
    private bool requirePasswordChangeOnReset = true;
    private string resetPasswordError = "";
    private bool isResettingPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        isSuperAdmin = role == "SuperAdmin";

        if (isSuperAdmin)
        {
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (uint.TryParse(userIdClaim, out var userId))
            {
                currentUserId = userId;
            }

            await LoadUsers();
        }
    }

    private async Task LoadUsers()
    {
        users = await Db.Users.OrderByDescending(u => u.CreatedAt).ToListAsync();
        totalUsers = users.Count;
        onlineUsers = users.Count(u => IsUserOnline(u));
        superAdminCount = users.Count(u => u.Role == UserRole.SuperAdmin);
        adminCount = users.Count(u => u.Role == UserRole.Admin);
    }

    private bool IsUserOnline(User user)
    {
        if (!user.LastLoginAt.HasValue) return false;
        var threshold = DateTime.UtcNow.AddMinutes(-30);
        return user.LastLoginAt.Value > threshold && user.IsActive;
    }

    private string GetInitial(string name)
    {
        return string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();
    }

    private async Task ViewUserActivity(uint userId)
    {
        var user = users.FirstOrDefault(u => u.UserId == userId);
        if (user == null) return;

        selectedUserName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.FullName : user.DisplayName;
        selectedUserActivities = await Db.UserActivities
            .Where(a => a.UserId == userId)
            .OrderByDescending(a => a.CreatedAt)
            .Take(50)
            .ToListAsync();

        showActivityModal = true;
    }

    private void CloseActivityModal()
    {
        showActivityModal = false;
        selectedUserActivities = null;
        selectedUserName = "";
    }

    private async Task ToggleUserStatus(User user)
    {
        user.IsActive = !user.IsActive;
        user.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadUsers();
        await ShowToast($"User {(user.IsActive ? "activated" : "deactivated")} successfully.");
    }

    private void OpenDeactivateModal(User user)
    {
        userToToggle = user;
        showDeactivateModal = true;
    }

    private void OpenReactivateModal(User user)
    {
        userToToggle = user;
        showReactivateModal = true;
    }

    private void CloseConfirmModal()
    {
        showDeactivateModal = false;
        showReactivateModal = false;
        userToToggle = null;
    }

    private async Task ConfirmDeactivate()
    {
        if (userToToggle == null) return;

        userToToggle.IsActive = false;
        userToToggle.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadUsers();
        await ShowToast($"{userToToggle.FullName}'s account has been deactivated.", "danger");
        CloseConfirmModal();
    }

    private async Task ConfirmReactivate()
    {
        if (userToToggle == null) return;

        userToToggle.IsActive = true;
        userToToggle.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadUsers();
        await ShowToast($"{userToToggle.FullName}'s account has been re-enabled.");
        CloseConfirmModal();
    }

    private void OpenResetPasswordModal(User user)
    {
        userToReset = user;
        resetPassword = "";
        showResetPassword = false;
        requirePasswordChangeOnReset = true;
        resetPasswordError = "";
        showResetPasswordModal = true;
    }

    private void CloseResetPasswordModal()
    {
        showResetPasswordModal = false;
        userToReset = null;
        resetPassword = "";
        showResetPassword = false;
        requirePasswordChangeOnReset = true;
        resetPasswordError = "";
    }

    private void GenerateResetPassword()
    {
        resetPassword = PasswordGenerator.GeneratePassword(16);
        showResetPassword = true;
    }

    private async Task ConfirmResetPassword()
    {
        if (userToReset == null) return;

        resetPasswordError = "";

        if (string.IsNullOrWhiteSpace(resetPassword))
        {
            resetPasswordError = "Please enter a password or generate one.";
            return;
        }

        if (resetPassword.Length < 8)
        {
            resetPasswordError = "Password must be at least 8 characters long.";
            return;
        }

        isResettingPassword = true;

        try
        {
            userToReset.PasswordHash = BCrypt.Net.BCrypt.HashPassword(resetPassword);
            userToReset.RequirePasswordChange = requirePasswordChangeOnReset;
            userToReset.UpdatedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            await ShowToast($"Password reset for {userToReset.FullName}. New password: {resetPassword}");
            CloseResetPasswordModal();
        }
        catch (Exception ex)
        {
            resetPasswordError = "Failed to reset password: " + ex.Message;
        }
        finally
        {
            isResettingPassword = false;
        }
    }

    private void OpenAddUserModal()
    {
        newUserFullName = "";
        newUserEmail = "";
        newUserUsername = "";
        newUserRole = "Admin";
        newUserPassword = "";
        showPassword = false;
        formError = "";
        showAddUserModal = true;
    }

    private void CloseAddUserModal()
    {
        showAddUserModal = false;
    }

    private void GeneratePassword()
    {
        newUserPassword = PasswordGenerator.GeneratePassword(16);
        showPassword = true;
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task CreateUser()
    {
        formError = "";

        if (string.IsNullOrWhiteSpace(newUserFullName) ||
            string.IsNullOrWhiteSpace(newUserEmail) ||
            string.IsNullOrWhiteSpace(newUserUsername) ||
            string.IsNullOrWhiteSpace(newUserPassword))
        {
            formError = "Please fill in all fields.";
            return;
        }

        if (!newUserEmail.Contains("@") || !newUserEmail.Contains("."))
        {
            formError = "Please enter a valid email address.";
            return;
        }

        if (newUserPassword.Length < 8)
        {
            formError = "Password must be at least 8 characters long.";
            return;
        }

        var existingUser = await Db.Users.FirstOrDefaultAsync(u => u.Username == newUserUsername);
        if (existingUser != null)
        {
            formError = "Username already exists. Please choose a different username.";
            return;
        }

        isSaving = true;

        try
        {
            var newUser = new User
            {
                Username = newUserUsername.Trim(),
                Email = newUserEmail.Trim(),
                FullName = newUserFullName.Trim(),
                DisplayName = newUserFullName.Trim(),
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(newUserPassword),
                Role = Enum.Parse<UserRole>(newUserRole),
                IsActive = true,
                FailedLoginAttempts = 0,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            Db.Users.Add(newUser);
            await Db.SaveChangesAsync();

            await LoadUsers();
            showAddUserModal = false;
            await ShowToast($"User {newUserFullName} created successfully.");
        }
        catch (Exception ex)
        {
            formError = "Failed to create user: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ShowToast(string text, string type = "success")
    {
        await JS.InvokeVoidAsync("showToast", text, type);
    }
}
