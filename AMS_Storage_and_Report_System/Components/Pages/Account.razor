@page "/account"
@layout AppLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ProfilePictureStorage Pictures
@inject ModalService Modal
@inject IJSRuntime JS
@inject ILogger<Account> Log

<PageTitle>Accounts | AMS StockWatch</PageTitle>

<PageHeader Title="Accounts" Subtitle="Sign-in accounts for AMS staff and for the offices that use the AMS Supplies portal.">
    <Actions>
        @if (_isSuperAdmin)
        {
            <button type="button" class="btn btn-accent" @onclick="OpenAdd"><i class="bi bi-person-plus me-1" aria-hidden="true"></i> Add account</button>
        }
    </Actions>
</PageHeader>

<div class="wrap page-body">
    @if (_loading)
    {
        <div class="panel"><div class="loading">Loading accounts…</div></div>
    }
    else if (!_isSuperAdmin)
    {
        <NoAccess Title="Only Super Admins can manage accounts" Message="Ask a Super Admin to add or reset an account for you." />
    }
    else
    {
        <div class="stat-grid">
            <button type="button" class="stat @(_scope == "all" ? "is-active" : "")" @onclick='() => _scope = "all"'>
                <span class="stat-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_users.Count</span><span class="stat-label">All accounts</span></span>
            </button>
            <button type="button" class="stat @(_scope == "staff" ? "is-active" : "")" @onclick='() => _scope = "staff"'>
                <span class="stat-icon is-gold"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_users.Count(u => u.IsStaff)</span><span class="stat-label">AMS staff</span></span>
            </button>
            <button type="button" class="stat @(_scope == "office" ? "is-active" : "")" @onclick='() => _scope = "office"'>
                <span class="stat-icon is-ok"><i class="bi bi-building" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_users.Count(u => u.Role == UserRole.Office)</span><span class="stat-label">Office accounts</span></span>
            </button>
            <div class="stat">
                <span class="stat-icon is-warn"><i class="bi bi-activity" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_users.Count(RecentlyActive)</span><span class="stat-label">Signed in, last 30 minutes</span></span>
            </div>
        </div>

        <section class="panel">
            <header class="panel-head">
                <div class="input-icon flex-grow-1" style="max-width: 420px">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" class="form-control" placeholder="Search by name, username, email or office"
                           aria-label="Search accounts" autocomplete="off" @bind="_search" @bind:event="oninput" />
                </div>
                <span class="meta">@Visible.Count() shown</span>
            </header>

            @if (!Visible.Any())
            {
                <div class="empty-state"><i class="bi bi-search" aria-hidden="true"></i><h2>No accounts match</h2><p>Try another word or show all accounts.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Account</th><th>Role</th><th>Status</th><th>Last sign-in</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var u in Visible)
                            {
                                <tr class="@(u.IsActive ? "" : "is-dim")" @key="u.UserId">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar" style="width:36px;height:36px;font-size:.875rem">
                                                @if (Pictures.GetProfilePictureUrl(u.ProfilePicturePath) is { } pic) { <img src="@pic" alt="" /> }
                                                else { @Initial(u.Name) }
                                            </span>
                                            <span>
                                                <span class="cell-strong">@u.Name @(u.UserId == _currentUserId ? "(you)" : "")</span>
                                                <span class="cell-sub">@u.Username, @u.Email</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-pill @RoleBadge(u)">@RoleLabel(u)</span>
                                    </td>
                                    <td>
                                        @if (!u.IsActive) { <span class="badge-pill badge-grey">Deactivated</span> }
                                        else if (u.LockedUntil > PhTime.Now) { <span class="badge-pill badge-bad"><i class="bi bi-lock-fill" aria-hidden="true"></i>Locked</span> }
                                        else if (u.RequirePasswordChange) { <span class="badge-pill badge-warn">Must change password</span> }
                                        else { <span class="badge-pill badge-ok"><span class="dot"></span>Active</span> }
                                    </td>
                                    <td class="text-nowrap">
                                        @if (u.LastLoginAt is { } last) { @last.ToString("MMM d, yyyy") <span class="cell-sub">@last.ToString("h:mm tt")</span> }
                                        else { <span class="is-muted">Never</span> }
                                    </td>
                                    <td>
                                        <div class="row-actions justify-content-end">
                                            <button type="button" class="act" @onclick="() => ShowActivityAsync(u)"><i class="bi bi-clock-history" aria-hidden="true"></i>Activity</button>
                                            @if (u.UserId != _currentUserId)
                                            {
                                                <button type="button" class="act" @onclick="() => OpenReset(u)"><i class="bi bi-key" aria-hidden="true"></i>Reset password</button>
                                            }
                                            else
                                            {
                                                <a class="act" href="/profile"><i class="bi bi-key" aria-hidden="true"></i>Change in My profile</a>
                                            }
                                            @if (u.UserId != _currentUserId)
                                            {
                                                @if (u.IsActive)
                                                {
                                                    <button type="button" class="act is-danger" @onclick="() => SetActiveAsync(u, false)"><i class="bi bi-person-slash" aria-hidden="true"></i>Deactivate</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="act is-ok" @onclick="() => SetActiveAsync(u, true)"><i class="bi bi-person-check" aria-hidden="true"></i>Re-enable</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@* ── Add account ── *@
<Dialog Show="_addOpen" Title="Add account" Icon="bi-person-plus" Busy="_saving" OnClose="() => _addOpen = false">
    <ChildContent>
        <div class="field">
            <label class="form-label" for="a-role">Account type</label>
            <Picker TValue="string" Id="a-role" Options="RoleOptions" @bind-Value="_nRole" />
        </div>
        @if (_nRole == "Office")
        {
            <div class="field">
                <label class="form-label" for="a-office">Office</label>
                <Picker TValue="int" Id="a-office" Options="OfficeChoices" @bind-Value="_nOfficeId" />
            </div>
        }
        <div class="field">
            <label class="form-label" for="a-name">@(_nRole == "Office" ? "Account name" : "Full name")</label>
            <input id="a-name" class="form-control" autocomplete="off" maxlength="100" @bind="_nFullName"
                   placeholder="@(_nRole == "Office" ? "Example: Learner Rights and Protection Office" : "Example: Juan P. Dela Cruz")" />
        </div>
        <div class="row g-3 mt-0">
            <div class="col-sm-6">
                <label class="form-label" for="a-user">Username</label>
                <input id="a-user" class="form-control" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="50" @bind="_nUsername" />
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="a-email">Email</label>
                <input id="a-email" type="email" class="form-control" autocomplete="off" maxlength="100" @bind="_nEmail" />
            </div>
        </div>
        <div class="field mt-3">
            <label class="form-label" for="a-pass">Temporary password</label>
            <div class="password-group">
                <input id="a-pass" class="form-control" type="@(_showNewPass ? "text" : "password")" autocomplete="off" @bind="_nPassword" />
                <button type="button" class="btn-icon" @onclick="() => _showNewPass = !_showNewPass" aria-label="@(_showNewPass ? "Hide password" : "Show password")">
                    <i class="bi @(_showNewPass ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-primary" @onclick="() => { _nPassword = PasswordGenerator.GeneratePassword(14); _showNewPass = true; }">
                    <i class="bi bi-magic me-1" aria-hidden="true"></i>Generate
                </button>
            </div>
            <div class="form-text">At least 8 characters, with letters and numbers. They'll be asked to change it the first time they sign in.</div>
        </div>
        @if (_formError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_formError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _addOpen = false" disabled="@_saving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="CreateAsync" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            Create account
        </button>
    </Footer>
</Dialog>

@* ── Reset password ── *@
<Dialog Show="_resetUser is not null" Title="@($"Reset password for {_resetUser?.Name}")" Icon="bi-key" Variant="warning"
        Busy="_saving" OnClose="() => _resetUser = null">
    <ChildContent>
        <div class="field">
            <label class="form-label" for="r-pass">New password</label>
            <div class="password-group">
                <input id="r-pass" class="form-control" type="@(_showResetPass ? "text" : "password")" autocomplete="off" @bind="_resetPassword" />
                <button type="button" class="btn-icon" @onclick="() => _showResetPass = !_showResetPass" aria-label="@(_showResetPass ? "Hide password" : "Show password")">
                    <i class="bi @(_showResetPass ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-primary" @onclick="() => { _resetPassword = PasswordGenerator.GeneratePassword(14); _showResetPass = true; }">
                    <i class="bi bi-magic me-1" aria-hidden="true"></i>Generate
                </button>
            </div>
            <div class="form-text">At least 8 characters, with letters and numbers. Anyone signed in with the old password is signed out within 5 minutes.</div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="r-require" @bind="_resetRequireChange" />
            <label class="form-check-label" for="r-require">Ask them to choose their own password at next sign-in</label>
        </div>
        @if (_formError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_formError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _resetUser = null" disabled="@_saving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="ResetAsync" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            Reset password
        </button>
    </Footer>
</Dialog>

@* ── Show a new password once ── *@
<Dialog Show="_issued is not null" Title="Password ready" Icon="bi-check-circle" Variant="success" OnClose="() => _issued = null">
    <ChildContent>
        <p class="am-message">Give this password to <strong>@_issued?.Name</strong> in person or through a private message. It won't be shown again.</p>
        <div class="secret-box">
            <code>@_issued?.Password</code>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CopyAsync"><i class="bi bi-clipboard me-1" aria-hidden="true"></i>@(_copied ? "Copied" : "Copy")</button>
        </div>
        <p class="small text-muted-2 mb-0">Username: <strong>@_issued?.Username</strong></p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-primary" @onclick="() => _issued = null">Done</button>
    </Footer>
</Dialog>

@* ── Activity ── *@
<Dialog Show="_activityUser is not null" Title="@($"Activity of {_activityUser?.Name}")" Icon="bi-clock-history" Size="lg" DismissOnBackdrop="true" OnClose="() => _activityUser = null">
    <ChildContent>
        @if (_activities is null)
        {
            <div class="loading">Loading…</div>
        }
        else if (_activities.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-clock" aria-hidden="true"></i><h2>No activity yet</h2><p>Sign-ins and changes will be listed here.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>When</th><th>Activity</th><th>Details</th><th>IP address</th></tr></thead>
                    <tbody>
                        @foreach (var a in _activities)
                        {
                            <tr>
                                <td class="text-nowrap">@a.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td><span class="badge-pill badge-navy">@a.ActivityType</span></td>
                                <td>@a.Description</td>
                                <td class="is-muted">@a.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted-2 mt-2 mb-0">Latest 50 entries.</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-primary" @onclick="() => _activityUser = null">Close</button>
    </Footer>
</Dialog>

@code {
    private sealed record IssuedPassword(string Name, string Username, string Password);

    private bool _loading = true, _isSuperAdmin;
    private uint _currentUserId;
    private List<User> _users = [];
    private List<Office> _offices = [];
    private string _scope = "all", _search = "";

    private bool _saving, _addOpen, _showNewPass, _showResetPass, _resetRequireChange = true, _copied;
    private string _nRole = "Admin", _nFullName = "", _nUsername = "", _nEmail = "", _nPassword = "";
    private int _nOfficeId;
    private string? _formError;
    private User? _resetUser;
    private string _resetPassword = "";
    private IssuedPassword? _issued;
    private User? _activityUser;
    private List<UserActivity>? _activities;

    private static readonly IReadOnlyList<PickOption<string>> RoleOptions =
    [
        new("Admin", "AMS Admin", "Uses this site"),
        new("SuperAdmin", "AMS Super Admin", "Uses this site and can manage accounts"),
        new("Office", "Office account", "Requests supplies through the AMS Supplies portal"),
    ];

    private IReadOnlyList<PickOption<int>> OfficeChoices =>
        [new(0, "Select an office"), .. _offices.Select(o => new PickOption<int>(o.OfficeId, o.OfficeAcronym, o.OfficeName))];

    private IEnumerable<User> Visible
    {
        get
        {
            var term = _search.Trim();
            return _users
                .Where(u => _scope == "all" || (_scope == "staff" ? u.IsStaff : u.Role == UserRole.Office))
                .Where(u => term.Length == 0
                    || u.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.Username.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (u.Office?.OfficeAcronym.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static string RoleBadge(User u) => u.Role switch
    {
        UserRole.SuperAdmin => "badge-gold",
        UserRole.Admin => "badge-navy",
        _ => "badge-ok",
    };

    private static string RoleLabel(User u) => u.Role switch
    {
        UserRole.SuperAdmin => "Super Admin",
        UserRole.Admin => "Admin",
        _ => $"Office, {u.Office?.OfficeAcronym ?? "unassigned"}",
    };

    private static bool StrongEnough(string p) => p.Length >= 8 && p.Any(char.IsLetter) && p.Any(char.IsDigit);

    private static bool RecentlyActive(User u) => u.IsActive && u.LastLoginAt > PhTime.Now.AddMinutes(-30);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _isSuperAdmin = user.IsInRole("SuperAdmin");
        uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _currentUserId);
        if (_isSuperAdmin) await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _users = await db.Users.AsNoTracking().Include(u => u.Office)
            .OrderBy(u => u.Role).ThenBy(u => u.FullName).ToListAsync();
        _offices = await db.Offices.AsNoTracking().OrderBy(o => o.OfficeAcronym).ToListAsync();
    }

    // ── Add ─────────────────────────────────────────────────────────────
    private void OpenAdd()
    {
        _nRole = "Admin"; _nFullName = _nUsername = _nEmail = _nPassword = "";
        _nOfficeId = 0; _showNewPass = false; _formError = null;
        _addOpen = true;
    }

    private async Task CreateAsync()
    {
        _formError = null;
        var role = Enum.Parse<UserRole>(_nRole);
        var username = _nUsername.Trim();
        var email = _nEmail.Trim();

        if (string.IsNullOrWhiteSpace(_nFullName)) _formError = "Enter the name.";
        else if (role == UserRole.Office && _nOfficeId == 0) _formError = "Select the office for this account.";
        else if (username.Length < 3 || username.Any(char.IsWhiteSpace)) _formError = "The username needs at least 3 characters and no spaces.";
        else if (!email.Contains('@') || !email.Contains('.')) _formError = "Enter a valid email address.";
        else if (!StrongEnough(_nPassword)) _formError = "The password needs at least 8 characters, with letters and numbers. Use Generate for a strong one.";
        if (_formError is not null) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.Users.AnyAsync(u => u.Username == username)) { _formError = "That username is already taken."; return; }
            if (await db.Users.AnyAsync(u => u.Email == email)) { _formError = "Another account already uses that email."; return; }

            var now = PhTime.Now;
            db.Users.Add(new User
            {
                Username = username, Email = email,
                FullName = _nFullName.Trim(), DisplayName = _nFullName.Trim(),
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(_nPassword, 12),
                Role = role, OfficeId = role == UserRole.Office ? _nOfficeId : null,
                IsActive = true, RequirePasswordChange = true,
                CreatedAt = now, UpdatedAt = now,
            });
            await LogAsync(db, "Create", $"Created {role} account '{username}'");
            await db.SaveChangesAsync();

            _addOpen = false;
            _issued = new IssuedPassword(_nFullName.Trim(), username, _nPassword);
            _copied = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Creating account failed");
            _formError = "The account couldn't be created. Check your connection and try again.";
        }
        finally { _saving = false; }
    }

    // ── Reset password ─────────────────────────────────────────────────
    private void OpenReset(User u)
    {
        _resetUser = u; _resetPassword = ""; _showResetPass = false; _resetRequireChange = true; _formError = null;
    }

    private async Task ResetAsync()
    {
        if (_resetUser is null) return;
        _formError = !StrongEnough(_resetPassword) ? "The password needs at least 8 characters, with letters and numbers. Use Generate for a strong one." : null;
        if (_formError is not null) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(_resetUser.UserId);
            if (u is null) { _formError = "This account no longer exists."; return; }
            u.PasswordHash = BCrypt.Net.BCrypt.HashPassword(_resetPassword, 12);
            u.RequirePasswordChange = _resetRequireChange;
            u.FailedLoginAttempts = 0;
            u.LockedUntil = null;   // a reset also unlocks the account
            u.UpdatedAt = PhTime.Now;
            await LogAsync(db, "Update", $"Reset the password of '{u.Username}'");
            await db.SaveChangesAsync();

            _issued = new IssuedPassword(_resetUser.Name, _resetUser.Username, _resetPassword);
            _copied = false;
            _resetUser = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Password reset failed");
            _formError = "The password couldn't be reset. Check your connection and try again.";
        }
        finally { _saving = false; }
    }

    private async Task CopyAsync()
    {
        if (_issued is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _issued.Password); _copied = true; }
        catch { /* clipboard blocked; the password is still on screen */ }
    }

    // ── Deactivate / re-enable ─────────────────────────────────────────
    private async Task SetActiveAsync(User target, bool active)
    {
        var ok = active
            ? await Modal.ConfirmAsync($"Re-enable {target.Name}?", "They'll be able to sign in again.", "Re-enable account", "Cancel", ModalVariant.Success)
            : await Modal.ConfirmAsync($"Deactivate {target.Name}?",
                "They won't be able to sign in until the account is re-enabled. Nothing they created is deleted.",
                "Deactivate account", "Cancel", ModalVariant.Danger);
        if (!ok) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(target.UserId);
            if (u is null) return;
            u.IsActive = active;
            u.UpdatedAt = PhTime.Now;
            await LogAsync(db, "Update", $"{(active ? "Re-enabled" : "Deactivated")} '{u.Username}'");
            await db.SaveChangesAsync();
            await LoadAsync();
            await JS.InvokeVoidAsync("showToast", $"{target.Name} was {(active ? "re-enabled" : "deactivated")}.", active ? "success" : "danger");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Changing account status failed");
            await Modal.ErrorAsync("Couldn't change the account", "Check your connection and try again.");
        }
    }

    // ── Activity ────────────────────────────────────────────────────────
    private async Task ShowActivityAsync(User u)
    {
        _activityUser = u;
        _activities = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        _activities = await db.UserActivities.AsNoTracking()
            .Where(a => a.UserId == u.UserId)
            .OrderByDescending(a => a.CreatedAt).Take(50).ToListAsync();
    }

    private Task LogAsync(AppDbContext db, string type, string description)
    {
        db.UserActivities.Add(new UserActivity { UserId = _currentUserId, ActivityType = type, Description = description, CreatedAt = PhTime.Now });
        return Task.CompletedTask;
    }
}
