@page "/app-cse"
@layout AppLayout
@attribute [Authorize]
@inject LiveRefresh Live
@implements IDisposable
@inject AppCseService AppCseSvc
@inject SettingsService Settings
@inject AuthenticationStateProvider AuthStateProvider
@inject ModalService Modal
@inject IJSRuntime JS

<PageTitle>APP-CSE | e-PINS</PageTitle>

<PageHeader Title="APP-CSE" Subtitle="Each office's Annual Procurement Plan for Common-Use Supplies. Offices can only request what's in their APP-CSE.">
    <Actions>
        <a class="btn btn-accent" href="@($"/exports/app-cse-template?year={_year}")"><i class="bi bi-file-earmark-excel me-1" aria-hidden="true"></i> Download Excel for @_year</a>
    </Actions>
</PageHeader>

<div class="wrap page-body">
    <section class="panel">
        <header class="panel-head">
            <h2>Upload APP-CSE</h2>
            <div style="min-width: 180px"><Picker TValue="int" Id="ap-year" Options="YearOptions" @bind-Value="_year" @bind-Value:after="YearChangedAsync" /></div>
        </header>
        <div class="panel-body">
            <p class="small mb-2"><strong>Upload either:</strong></p>
            <ul class="small text-muted-2 ps-3 mb-3">
                <li>the Regional Office's <strong>APP-CSE workbook</strong> (the PS-DBM form, one sheet per office). All office sheets are read at once; or</li>
                <li>the <strong>Excel file downloaded above</strong>, filled in with Q1–Q4 or a yearly total.</li>
            </ul>
            <p class="small text-muted-2 mb-3">Every row is checked first, and <strong>nothing is saved</strong> until you press Import.</p>
            <InputFile class="form-control" OnChange="OnFileSelected" accept=".xlsx" disabled="@_busy" />
            @if (_busy)
            {
                <p class="small text-muted-2 mt-2 mb-0"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Checking the file…</p>
            }
        </div>
    </section>

    @if (_preview is not null)
    {
        <section class="panel">
            <header class="panel-head">
                <h2>Check before importing: @_preview.FileName</h2>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light" @onclick="() => _preview = null">Discard</button>
                    <button type="button" class="btn btn-primary" @onclick="ImportAsync" disabled="@(!_preview.CanImport)">
                        <i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i> Import into FY @_preview.FiscalYear
                    </button>
                </div>
            </header>
            <div class="panel-body">
                @if (_preview.FileError is not null)
                {
                    <div class="callout is-bad mb-0"><i class="bi bi-x-octagon" aria-hidden="true"></i><p>@_preview.FileError</p></div>
                }
                else
                {
                    @if (_preview.Format == "official")
                    {
                        <div class="table-wrap mb-3">
                            <table class="data-table">
                                <thead><tr><th>Sheet</th><th>Office</th><th class="t-num">Items</th><th class="t-num">Units</th><th class="t-num">Warnings</th><th>Result</th></tr></thead>
                                <tbody>
                                    @foreach (var sh in _preview.Sheets)
                                    {
                                        <tr>
                                            <td class="cell-strong">@sh.Sheet</td>
                                            <td>@(sh.Office ?? "–")</td>
                                            <td class="t-num">@(sh.Status == "Check only" ? "" : sh.Items.ToString("N0"))</td>
                                            <td class="t-num">@(sh.Status == "Check only" ? "" : sh.Units.ToString("N0"))</td>
                                            <td class="t-num">@(sh.Warnings > 0 ? sh.Warnings.ToString() : "")</td>
                                            <td>
                                                <span class="badge-pill @SheetBadge(sh.Status)">@sh.Status</span>
                                                @if (sh.Note is not null) { <span class="cell-sub">@sh.Note</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @foreach (var n in _preview.Notices)
                        {
                            <div class="callout mb-2"><i class="bi bi-info-circle" aria-hidden="true"></i><p>@n</p></div>
                        }
                        @if (_preview.NewItems.Count > 0)
                        {
                            <div class="new-items-box mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="ap-add-items" @bind="_preview.AddMissingItems" />
                                    <label class="form-check-label fw-semibold" for="ap-add-items">
                                        Add the @_preview.NewItems.Count item(s) that aren't in the Catalog yet
                                        (@_preview.NewItems.Count(n => !n.FromPartII) from Part I, @_preview.NewItems.Count(n => n.FromPartII) from Part II)
                                    </label>
                                </div>
                                <p class="small text-muted-2 mb-2">
                                    @(_preview.AddMissingItems
                                        ? "They're added with the PS-DBM code as the stock no. (Part II items get OTH-001, OTH-002, …), the unit and the unit price from the workbook. Stock starts at 0; record deliveries in Inventory."
                                        : "Off: rows for these items are skipped. Only items already in the Catalog are imported.")
                                </p>
                                <details>
                                    <summary class="small fw-semibold">See the items</summary>
                                    <div class="table-wrap mt-2">
                                        <table class="data-table">
                                            <thead><tr><th>Stock no.</th><th>Item</th><th>Unit</th><th class="t-num">Unit price</th><th>Category</th></tr></thead>
                                            <tbody>
                                                @foreach (var n in _preview.NewItems.Page(_pNew))
                                                {
                                                    <tr><td class="text-nowrap">@n.StockNo</td><td>@n.Name</td><td>@n.Unit</td><td class="t-num">@(n.Price > 0 ? "₱" + n.Price.ToString("N2") : "–")</td><td class="is-muted">@n.Category</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <Pager Total="_preview.NewItems.Count" @bind-Page="_pNew" ResetKey="@_preview.GetHashCode().ToString()" Label="New item pages" />
                                </details>
                            </div>
                        }
                    }
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge-pill badge-ok">@_preview.Rows.Count(r => r.Change == "New") new</span>
                        <span class="badge-pill badge-navy">@_preview.Rows.Count(r => r.Change == "Changed") changed</span>
                        <span class="badge-pill badge-grey">@_preview.Rows.Count(r => r.Change == "Unchanged") unchanged</span>
                        <span class="badge-pill @(_preview.Errors > 0 ? "badge-bad" : "badge-grey")">@_preview.Errors with errors</span>
                        <span class="badge-pill badge-warn">@_preview.Rows.Count(r => r.Warning is not null) warnings</span>
                    </div>
                    @if (_preview.Errors > 0)
                    {
                        <div class="callout is-bad"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><p>Fix the rows marked <strong>Error</strong> in Excel, then upload the file again. Rows with errors are listed first.</p></div>
                    }
                    else if (!_preview.CanImport)
                    {
                        <div class="callout"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Everything in this file is already saved. There's nothing new to import.</p></div>
                    }
                }
            </div>
            @if (_preview.Rows.Count > 0)
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>@(_preview.Format == "official" ? "Sheet / row" : "Row")</th><th>Office</th><th>Item</th><th class="t-num">Q1</th><th class="t-num">Q2</th><th class="t-num">Q3</th><th class="t-num">Q4</th><th class="t-num">New total</th><th class="t-num">Was</th><th>Result</th></tr></thead>
                        <tbody>
                            @foreach (var r in _preview.Rows.OrderBy(r => r.Error is null).ThenBy(r => r.Change == "Unchanged").ThenBy(r => r.RowNumber).Page(_pPreview))
                            {
                                <tr>
                                    <td class="is-muted text-nowrap">@(r.Sheet is null ? r.RowNumber.ToString() : $"{r.Sheet} · {r.RowNumber}")</td>
                                    <td class="cell-strong">@r.OfficeAcronym</td>
                                    <td>
                                        <span>@(r.ItemName ?? r.StockNo)</span>
                                        <span class="cell-sub">@r.StockNo @if (r.NewItemKey is not null) {<span class="badge-pill badge-gold ms-1">New to catalog</span>}</span>
                                    </td>
                                    <td class="t-num">@r.Q1</td><td class="t-num">@r.Q2</td><td class="t-num">@r.Q3</td><td class="t-num">@r.Q4</td>
                                    <td class="t-num"><strong>@r.Total</strong></td>
                                    <td class="t-num is-muted">@r.CurrentTotal</td>
                                    <td>
                                        <span class="badge-pill @ChangeBadge(r.Change)">@r.Change</span>
                                        @if (r.Error is not null) { <span class="cell-sub text-danger">@r.Error</span> }
                                        else if (r.Warning is not null) { <span class="cell-sub" style="color: var(--warn)">@r.Warning</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Total="_preview.Rows.Count" @bind-Page="_pPreview" ResetKey="@_preview.GetHashCode().ToString()" Label="Preview pages" />
            }
        </section>
    }

    <section class="panel">
        <header class="panel-head">
            <h2>Current APP-CSE, FY @_year</h2>
            <div style="min-width: 260px"><Picker TValue="int" Id="ap-office" Options="OfficeOptions" @bind-Value="_officeId" @bind-Value:after="LoadAllocationsAsync" /></div>
        </header>
        @if (_allocations is null)
        {
            <div class="loading">Loading…</div>
        }
        else if (_allocations.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-clipboard-x" aria-hidden="true"></i><h2>Nothing loaded for FY @_year</h2><p>Download the Excel file, fill it in and upload it above.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>Office</th><th>Item</th><th class="t-num">Q1</th><th class="t-num">Q2</th><th class="t-num">Q3</th><th class="t-num">Q4</th><th class="t-num">Total</th><th class="t-num">Issued</th></tr></thead>
                    <tbody>
                        @foreach (var a in _allocations.Page(_pAlloc))
                        {
                            <tr>
                                <td class="cell-strong">@a.Office?.OfficeAcronym</td>
                                <td><span>@a.Item?.ItemName</span><span class="cell-sub">@a.Item?.StockNo</span></td>
                                <td class="t-num">@a.Q1Qty</td><td class="t-num">@a.Q2Qty</td><td class="t-num">@a.Q3Qty</td><td class="t-num">@a.Q4Qty</td>
                                <td class="t-num"><strong>@a.AllocatedQty</strong></td>
                                <td class="t-num">@a.IssuedQty</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="_allocations.Count" @bind-Page="_pAlloc" ResetKey="@($"{_year}|{_officeId}")" Label="APP-CSE pages" />
        }
    </section>

    @if (_uploads.Count > 0)
    {
        <section class="panel">
            <header class="panel-head"><h2>Recent uploads, FY @_year</h2></header>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>When</th><th>File</th><th>Result</th></tr></thead>
                    <tbody>
                        @foreach (var u in _uploads.Page(_pUploads))
                        {
                            <tr><td class="text-nowrap">@u.UploadedAt.ToString("MMM d, yyyy h:mm tt")</td><td>@u.OriginalFileName</td><td class="is-muted">@u.Notes</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="_uploads.Count" @bind-Page="_pUploads" ResetKey="@_year.ToString()" Label="Upload pages" />
        </section>
    }
</div>

@code {
    private int _pNew = 1;
    private int _pPreview = 1;
    private int _pUploads = 1;
    private int _pAlloc = 1;
    private int _year = PhTime.Now.Year;
    private int _officeId;
    private uint _userId;
    private bool _busy;
    private AppCsePreview? _preview;
    private List<AppCseAllocation>? _allocations;
    private List<AppCseUpload> _uploads = [];
    private List<Office> _offices = [];

    private IReadOnlyList<PickOption<int>> YearOptions
    {
        get
        {
            var now = PhTime.Now.Year;
            return [new(now - 1, $"FY {now - 1}"), new(now, $"FY {now}", "Current year"), new(now + 1, $"FY {now + 1}", "Next year")];
        }
    }

    private IReadOnlyList<PickOption<int>> OfficeOptions =>
        [new(0, "All offices"), .. _offices.Where(o => o.CanRequisition).Select(o => new PickOption<int>(o.OfficeId, o.OfficeAcronym, o.OfficeName))];

    private static string SheetBadge(string status) => status switch
    {
        "Read" => "badge-ok", "Error" => "badge-bad", "Skipped" => "badge-warn", _ => "badge-grey",
    };

    private static string ChangeBadge(string change) => change switch
    {
        "New" => "badge-ok", "Changed" => "badge-navy", "Error" => "badge-bad", _ => "badge-grey",
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
        _offices = await Settings.OfficesAsync();
        await YearChangedAsync();
    }

    private async Task YearChangedAsync()
    {
        _preview = null;
        await LoadAllocationsAsync();
        _uploads = await AppCseSvc.UploadsAsync(_year);
    }

    private async Task LoadAllocationsAsync()
    {
        _allocations = null;
        _allocations = await AppCseSvc.AllocationsAsync(_year, _officeId);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _preview = null;
        if (!e.File.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            _preview = new AppCsePreview { FileName = e.File.Name, FiscalYear = _year, FileError = "Upload an Excel workbook (.xlsx). If you have an .xls or .csv file, open it in Excel and save it as .xlsx." };
            return;
        }
        if (e.File.Size > AppCseService.MaxFileBytes)
        {
            _preview = new AppCsePreview { FileName = e.File.Name, FiscalYear = _year, FileError = "The file is larger than 5 MB." };
            return;
        }

        _busy = true;
        try
        {
            await using var stream = e.File.OpenReadStream(AppCseService.MaxFileBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            _preview = await AppCseSvc.PreviewAsync(ms, e.File.Name, _year);
        }
        finally { _busy = false; }
    }

    private async Task ImportAsync()
    {
        if (_preview is null) return;
        var p = _preview;
        var ok = await Modal.ConfirmAsync($"Import APP-CSE for FY {p.FiscalYear}?",
            $"{p.Rows.Count(r => p.WillImport(r) && r.Change == "New")} new and {p.Rows.Count(r => p.WillImport(r) && r.Change == "Changed")} changed allocations will be saved"
            + (p.AddMissingItems && p.NewItems.Count > 0 ? $", and {p.NewItems.Count} item(s) will be added to the Catalog" : "")
            + ". Offices see the new figures right away.",
            "Import", "Go back", ModalVariant.Success,
            onConfirmAsync: async _ =>
            {
                var r = await AppCseSvc.ImportAsync(p, _userId);
                return r.Ok ? null : r.Message;
            });
        if (!ok) return;
        _preview = null;
        await YearChangedAsync();
        await JS.InvokeVoidAsync("showToast", $"APP-CSE for FY {p.FiscalYear} saved.", "success");
    }

    // Live update: when APP-CSE or the catalog changes on either website, reload without refreshing.
    private static readonly string[] LiveAreas = ["appcse", "catalog"];
    protected override void OnInitialized() => Live.AreasChanged += OnAreasAsync;

    private async Task OnAreasAsync(IReadOnlySet<string> areas)
    {
        if (!areas.Overlaps(LiveAreas)) return;
        // Swap the rows in place (no "Loading..." blink while someone is reading the table)
        _allocations = await AppCseSvc.AllocationsAsync(_year, _officeId);
        StateHasChanged();
    }

    public void Dispose() => Live.AreasChanged -= OnAreasAsync;
}
