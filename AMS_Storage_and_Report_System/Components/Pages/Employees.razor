@page "/employees"
@layout AppLayout
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ModalService Modal
@inject IJSRuntime JS
@inject ILogger<Employees> Log

<PageTitle>Employees | AMS StockWatch</PageTitle>

<PageHeader Title="Employees" Subtitle="Regional Office personnel by office. They appear in property documents and as RIS signatories.">
    <Actions>
        <button type="button" class="btn btn-accent" @onclick="OpenAdd">
            <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Add employee
        </button>
    </Actions>
</PageHeader>

<div class="wrap page-body">
    @if (_loading)
    {
        <div class="panel"><div class="loading">Loading employees…</div></div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat">
                <span class="stat-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_groups.Count</span><span class="stat-label">Offices with personnel</span></span>
            </div>
            <div class="stat">
                <span class="stat-icon is-ok"><i class="bi bi-people" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_totalPersonnel</span><span class="stat-label">RO personnel</span></span>
            </div>
        </div>

        <section class="panel">
            <header class="panel-head">
                <div class="filters flex-grow-1">
                    <div>
                        <label class="form-label" for="f-office">Office</label>
                        <Picker TValue="int" Id="f-office" Options="@(OfficeOptions("All offices"))" @bind-Value="_filterOfficeId" />
                    </div>
                    <div>
                        <label class="form-label" for="f-search">Search</label>
                        <div class="input-icon">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input id="f-search" type="search" class="form-control" placeholder="Name or position"
                                   autocomplete="off" @bind="_search" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            </header>

            @if (!VisibleGroups.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <h2>@(_totalPersonnel == 0 ? "No employees yet" : "No employees match")</h2>
                    <p>@(_totalPersonnel == 0 ? "Add the Regional Office personnel for each office." : "Try a different office or search word.")</p>
                    @if (_totalPersonnel == 0)
                    {
                        <button type="button" class="btn btn-primary" @onclick="OpenAdd">Add employee</button>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Name</th><th>Position</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var g in VisibleGroups)
                            {
                                <tr class="group-row" @key="@($"office-{g.Office.OfficeId}")">
                                    <td colspan="3">@g.Office.OfficeName <span class="cell-sub">@g.Office.OfficeAcronym, @g.Personnel.Count @(g.Personnel.Count == 1 ? "person" : "people")</span></td>
                                </tr>
                                @foreach (var p in g.Personnel)
                                {
                                    <tr @key="@($"person-{p.PersonnelId}")">
                                        <td class="cell-strong">@p.FullName</td>
                                        <td>@p.Position</td>
                                        <td>
                                            <div class="row-actions justify-content-end">
                                                <button type="button" class="act" @onclick="() => OpenEdit(p)"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</button>
                                                <button type="button" class="act is-danger" @onclick="() => DeleteAsync(p)"><i class="bi bi-trash3" aria-hidden="true"></i>Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

<Dialog Show="_formOpen" Title="@(_editingId is null ? "Add employee" : "Edit employee")" Icon="bi-person-badge"
        Busy="_saving" OnClose="() => _formOpen = false">
    <ChildContent>
        @if (!_newOffice)
        {
            <div class="field">
                <label class="form-label" for="e-office">Office</label>
                <Picker TValue="int" Id="e-office" Options="@(OfficeOptions("Select an office"))" @bind-Value="_officeId" />
                <button type="button" class="btn btn-link px-0 small" @onclick="StartNewOffice">
                    Office not in the list? Add a new office
                </button>
            </div>
        }
        else
        {
            <div class="field">
                <label class="form-label" for="e-office-name">New office name</label>
                <input id="e-office-name" class="form-control" autocomplete="off" value="@_officeName" @oninput="OnOfficeNameInput"
                       placeholder="Example: Learner Rights and Protection Office" />
            </div>
            <div class="field">
                <label class="form-label" for="e-office-acr">Acronym</label>
                <input id="e-office-acr" class="form-control" autocomplete="off" maxlength="20" value="@_officeAcronym" @oninput="OnAcronymInput" />
                <div class="form-text">Filled in from the office name. Change it if it's not the official acronym.</div>
                <button type="button" class="btn btn-link px-0 small" @onclick="() => _newOffice = false">Choose an existing office instead</button>
            </div>
        }

        <div class="field">
            <label class="form-label" for="e-name">Full name</label>
            <input id="e-name" class="form-control" autocomplete="off" maxlength="150" @bind="_fullName" placeholder="Example: Juan P. Dela Cruz" />
        </div>
        <div class="field">
            <label class="form-label" for="e-position">Position</label>
            <input id="e-position" class="form-control" autocomplete="off" maxlength="100" @bind="_position" placeholder="Example: Administrative Officer V" />
            <div class="form-text">Write the full position title, without abbreviations. It's printed on RIS and property documents.</div>
        </div>

        @if (_formError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_formError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _formOpen = false" disabled="@_saving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            @(_editingId is null ? "Add employee" : "Save changes")
        </button>
    </Footer>
</Dialog>

@code {
    private sealed record OfficeGroup(Office Office, List<RoPersonnel> Personnel);

    private bool _loading = true;
    private List<Office> _offices = [];
    private List<OfficeGroup> _groups = [];
    private int _totalPersonnel;
    private int _filterOfficeId;
    private string _search = "";

    private bool _formOpen, _saving, _newOffice, _acronymTouched;
    private int? _editingId;
    private int _officeId;
    private string _officeName = "", _officeAcronym = "", _fullName = "", _position = "";
    private string? _formError;

    private IReadOnlyList<PickOption<int>> OfficeOptions(string first) =>
        [new(0, first), .. _offices.Select(o => new PickOption<int>(o.OfficeId, o.OfficeAcronym, o.OfficeName))];

    private IEnumerable<OfficeGroup> VisibleGroups
    {
        get
        {
            var term = _search.Trim();
            return _groups
                .Where(g => _filterOfficeId == 0 || g.Office.OfficeId == _filterOfficeId)
                .Select(g => term.Length == 0 ? g : g with
                {
                    Personnel = g.Personnel.Where(p =>
                        p.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                        p.Position.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList()
                })
                .Where(g => g.Personnel.Count > 0);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _offices = await db.Offices.AsNoTracking().OrderBy(o => o.OfficeAcronym).ToListAsync();
        var personnel = await db.RoPersonnel.AsNoTracking().ToListAsync();
        _totalPersonnel = personnel.Count;

        _groups = _offices
            .Select(o => new OfficeGroup(o, personnel.Where(p => p.OfficeId == o.OfficeId)
                .OrderBy(p => PositionRank(p.Position)).ThenBy(p => p.FullName).ToList()))
            .Where(g => g.Personnel.Count > 0)
            .ToList();
    }

    private void OpenAdd()
    {
        _editingId = null;
        _officeId = _filterOfficeId;
        _newOffice = false;
        _officeName = _officeAcronym = _fullName = _position = "";
        _acronymTouched = false;
        _formError = null;
        _formOpen = true;
    }

    private void OpenEdit(RoPersonnel p)
    {
        _editingId = p.PersonnelId;
        _officeId = p.OfficeId;
        _newOffice = false;
        _fullName = p.FullName;
        _position = p.Position;
        _formError = null;
        _formOpen = true;
    }

    private void StartNewOffice()
    {
        _newOffice = true;
        _officeName = _officeAcronym = "";
        _acronymTouched = false;
    }

    private void OnOfficeNameInput(ChangeEventArgs e)
    {
        _officeName = e.Value?.ToString() ?? "";
        if (!_acronymTouched) _officeAcronym = MakeAcronym(_officeName);
    }

    private void OnAcronymInput(ChangeEventArgs e)
    {
        _officeAcronym = e.Value?.ToString() ?? "";
        _acronymTouched = true;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        var officeOk = _newOffice
            ? !string.IsNullOrWhiteSpace(_officeName) && !string.IsNullOrWhiteSpace(_officeAcronym)
            : _officeId != 0;
        if (!officeOk) { _formError = _newOffice ? "Enter the new office's name and acronym." : "Select the office."; return; }
        if (string.IsNullOrWhiteSpace(_fullName)) { _formError = "Enter the employee's full name."; return; }
        if (string.IsNullOrWhiteSpace(_position)) { _formError = "Enter the employee's position."; return; }

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var officeId = _officeId;

            if (_newOffice)
            {
                var name = _officeName.Trim();
                var acronym = _officeAcronym.Trim();
                var existing = await db.Offices.FirstOrDefaultAsync(o => o.OfficeName == name || o.OfficeAcronym == acronym);
                if (existing is not null)
                {
                    officeId = existing.OfficeId;
                }
                else
                {
                    var office = new Office { OfficeName = name, OfficeAcronym = acronym };
                    db.Offices.Add(office);
                    await db.SaveChangesAsync();
                    officeId = office.OfficeId;
                }
            }

            if (_editingId is null)
            {
                db.RoPersonnel.Add(new RoPersonnel { OfficeId = officeId, FullName = _fullName.Trim(), Position = _position.Trim() });
            }
            else
            {
                var person = await db.RoPersonnel.FindAsync(_editingId.Value);
                if (person is null) { _formError = "This employee was already removed. Close this window and refresh."; return; }
                person.OfficeId = officeId;
                person.FullName = _fullName.Trim();
                person.Position = _position.Trim();
            }
            await db.SaveChangesAsync();

            var added = _editingId is null;
            _formOpen = false;
            await LoadAsync();
            await Toast(added ? $"{_fullName.Trim()} was added." : "Changes saved.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving employee failed");
            _formError = "The employee couldn't be saved. Check your connection and try again.";
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(RoPersonnel p)
    {
        var confirmed = await Modal.ConfirmAsync($"Delete {p.FullName}?",
            "They'll be removed from the employee list. This can't be undone.",
            "Delete employee", "Cancel", ModalVariant.Danger);
        if (!confirmed) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var deleted = await db.RoPersonnel.Where(x => x.PersonnelId == p.PersonnelId).ExecuteDeleteAsync();
            await LoadAsync();
            await Toast(deleted > 0 ? $"{p.FullName} was deleted." : "Already removed.", "danger");
        }
        catch (Exception ex) when (ex.GetBaseException().Message.Contains("foreign key", StringComparison.OrdinalIgnoreCase))
        {
            await Modal.WarningAsync("This employee can't be deleted",
                $"{p.FullName} is linked to property documents or requisition slips. Those records need to keep the name, so the employee stays on the list.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting employee failed");
            await Modal.ErrorAsync("Couldn't delete", "Check your connection and try again.");
        }
    }

    private ValueTask Toast(string text, string type = "success") => JS.InvokeVoidAsync("showToast", text, type);

    // Sort senior positions first. "Assistant Regional Director" must be checked
    // before plain "Director", or it would rank as the Regional Director.
    private static int PositionRank(string position)
    {
        if (string.IsNullOrWhiteSpace(position)) return 99;
        var p = position.Trim();
        if (Has(p, "Assistant Regional Director", "Asst. Regional Director", "Asst Regional Director")) return 2;
        if (Has(p, "Regional Director", "Director")) return 1;
        if (Has(p, "Chief")) return 3;
        if (Has(p, "Administrative Officer V", "Officer V")) return 4;
        if (Has(p, "Administrative Officer", "Admin Officer")) return 5;
        if (Has(p, "Specialist V", "Engineer V", "Scientist V", "Specialist IV", "Engineer IV", "Scientist IV")) return 6;
        return 99;
    }

    private static bool Has(string source, params string[] terms) =>
        terms.Any(t => source.Contains(t, StringComparison.OrdinalIgnoreCase));

    private static string MakeAcronym(string officeName)
    {
        if (string.IsNullOrWhiteSpace(officeName)) return "";
        var skip = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "and", "of", "the", "for", "&" };
        return string.Concat(officeName.Split([' ', ',', '-'], StringSplitOptions.RemoveEmptyEntries)
            .Where(w => !skip.Contains(w)).Select(w => char.ToUpperInvariant(w[0])));
    }
}
