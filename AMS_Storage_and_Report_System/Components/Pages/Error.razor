@page "/Error"
@layout EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageTitle>Something went wrong | AMS StockWatch</PageTitle>

<div class="auth-page">
    <main class="auth-main">
        <div class="wrap">
            <div class="login-card text-center">
                <img class="login-seal" src="images/deped-ncr-seal.png" alt="" width="72" height="72" />
                <h1>Something went wrong</h1>
                <p class="login-sub">The request couldn't be completed. Try again; if it keeps happening, tell the system administrator.</p>
                @if (!string.IsNullOrEmpty(RequestId))
                {
                    <p class="small text-muted-2">Reference: <code>@RequestId</code></p>
                }
                <a class="btn btn-primary w-100" href="/dashboard">Back to the dashboard</a>
            </div>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
