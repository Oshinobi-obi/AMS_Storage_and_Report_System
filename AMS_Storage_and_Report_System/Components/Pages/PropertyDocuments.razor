@page "/property-documents"
@layout AppLayout
@attribute [Authorize]
@inject LiveRefresh Live
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PropertyDocumentStorage Storage
@inject PropertyDocumentLinks Links
@inject AuthenticationStateProvider AuthStateProvider
@inject ModalService Modal
@inject IJSRuntime JS
@inject ILogger<PropertyDocuments> Log

<PageTitle>Property documents | e-PINS</PageTitle>

<PageHeader Title="Property documents" Subtitle="Signed PAR, ICS and return slips for Regional Office personnel.">
    <Actions>
        <button type="button" class="btn btn-accent" @onclick="OpenUpload">
            <i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i> Upload document
        </button>
    </Actions>
</PageHeader>

<div class="wrap page-body">
    <div class="stat-grid">
        @foreach (var t in DocTypes)
        {
            <button type="button" class="stat @(_fType == t.Code ? "is-active" : "")" @onclick="() => ToggleTypeAsync(t.Code)">
                <span class="stat-icon @t.Tone"><i class="bi @t.Icon" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_counts.GetValueOrDefault(t.Code)</span><span class="stat-label">@t.Label</span></span>
            </button>
        }
    </div>

    <section class="panel">
        <div class="panel-body">
            <div class="filters">
                <div>
                    <label class="form-label" for="f-office">Office</label>
                    <Picker TValue="int" Id="f-office" Options="@(OfficeOptions("All offices"))"
                            @bind-Value="_fOfficeId" @bind-Value:after="OnFilterOfficeChangedAsync" />
                </div>
                <div>
                    <label class="form-label" for="f-type">Document</label>
                    <Picker TValue="string" Id="f-type" Options="@(DocTypeOptions("All documents"))"
                            @bind-Value="_fType" @bind-Value:after="RunFilterAsync" />
                </div>
                <div>
                    <label class="form-label" for="f-ptype">Type of property</label>
                    <Picker TValue="int" Id="f-ptype" Options="@(PropertyTypeOptions("All types"))"
                            @bind-Value="_fPropertyTypeId" @bind-Value:after="RunFilterAsync" />
                </div>
                <div>
                    <label class="form-label" for="f-equip">Equipment</label>
                    <Picker TValue="string" Id="f-equip" Options="EquipmentFilterOptions" @bind-Value="_fEquip" @bind-Value:after="RunFilterAsync" />
                </div>
                <div>
                    <label class="form-label" for="f-person">RO personnel</label>
                    <Picker TValue="int" Id="f-person" Disabled="@(_fOfficeId == 0)"
                            Options="@(PersonnelOptions(_fPersonnel, _fOfficeId == 0 ? "Choose an office first" : "Everyone in this office"))"
                            @bind-Value="_fPersonnelId" @bind-Value:after="RunFilterAsync" />
                </div>
            </div>
            @if (HasFilters)
            {
                <div class="filters-actions">
                    <button type="button" class="btn btn-light btn-sm" @onclick="ClearFiltersAsync"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Clear filters</button>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <header class="panel-head">
            <h2>@(_results is null ? "Documents" : $"{_results.Count} {(_results.Count == 1 ? "document" : "documents")}")</h2>
            @if (_selected.Count > 0)
            {
                <a class="btn btn-outline-primary btn-sm" href="@BulkDownloadUrl" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-zip me-1" aria-hidden="true"></i> Download selected (@_selected.Count)
                </a>
            }
        </header>

        @if (_results is null)
        {
            <div class="loading">Loading documents…</div>
        }
        else if (_results.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <h2>@(HasFilters ? "No documents match these filters" : "No documents uploaded yet")</h2>
                <p>@(HasFilters ? "Try clearing a filter." : "Upload signed PAR, ICS or return slips as PDF files.")</p>
                @if (!HasFilters)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenUpload">Upload document</button>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="cell-check">
                                <input class="form-check-input" type="checkbox" aria-label="Select all"
                                       checked="@(_selected.Count == _results.Count)" @onchange="ToggleAll" />
                            </th>
                            <th>Document</th><th>Type of property</th><th>Office</th><th>RO personnel</th><th>Date signed</th><th>Uploaded</th><th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _results.Page(_page))
                        {
                            <tr @key="doc.DocumentId" class="@(doc.ReturnedOn is not null ? "is-returned" : null)">
                                <td class="cell-check">
                                    <input class="form-check-input" type="checkbox" aria-label="@($"Select {doc.OriginalFileName}")"
                                           checked="@_selected.Contains(doc.DocumentId)"
                                           @onchange="e => ToggleOne(doc.DocumentId, e.Value is true)" />
                                </td>
                                <td>
                                    <span class="badge-pill @TypeBadge(doc.DocumentType)">@doc.DocumentType</span>
                                    <span class="cell-sub text-truncate" style="max-width: 260px" title="@doc.OriginalFileName">@doc.OriginalFileName</span>
                                    @if (PropertyStatus.SplitEquipment(doc.EquipmentType) is { Count: > 0 } equip)
                                    {
                                        <span class="equip-note" title="@string.Join(", ", equip)"><i class="bi @EquipmentPicker.Icon(equip[0])" aria-hidden="true"></i>@string.Join(", ", equip)</span>
                                    }
                                    else if (doc.DocumentType is "PAR" or "ICS")
                                    {
                                        <button type="button" class="equip-note is-none" @onclick="() => OpenEditAsync(doc)"><i class="bi bi-pc-display" aria-hidden="true"></i>Set the equipment</button>
                                    }
                                    @if (doc.DocumentType is "PAR" or "ICS")
                                    {
                                        @if (_summaries.TryGetValue(doc.DocumentId, out var sum))
                                        {
                                            <span class="linked-note"><i class="bi bi-box-seam" aria-hidden="true"></i>@sum.Items @(sum.Items == 1 ? "item" : "items") · ₱@sum.Total.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="linked-note is-none"><i class="bi bi-box-seam" aria-hidden="true"></i>No property linked yet</span>
                                        }
                                    }
                                    @if (doc.ReturnedOn is { } returned)
                                    {
                                        <span class="returned-note">
                                            <i class="bi bi-arrow-return-left" aria-hidden="true"></i>Returned @returned.ToString("MMM d, yyyy")
                                            @if (doc.ReturnSlipId is { } slipId)
                                            {
                                                <a href="/documents/view/@slipId" target="_blank" rel="noopener">Return slip</a>
                                            }
                                        </span>
                                    }
                                </td>
                                <td>@doc.PropertyType?.TypeName</td>
                                <td>@doc.Office?.OfficeAcronym</td>
                                <td><span class="cell-strong">@doc.Personnel?.FullName</span><span class="cell-sub">@doc.Personnel?.Position</span></td>
                                <td class="text-nowrap">
                                    @if (doc.DateSigned is { } signed)
                                    {
                                        <span>@signed.ToString("MMM d, yyyy")</span>
                                        <button type="button" class="act act-icon" title="Change the date signed" aria-label="@($"Change the date signed of {doc.OriginalFileName}")" @onclick="() => OpenDateSigned(doc)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="act act-set" title="Record when this document was signed" @onclick="() => OpenDateSigned(doc)"><i class="bi bi-calendar-plus" aria-hidden="true"></i>Set date</button>
                                    }
                                </td>
                                <td class="text-nowrap">@doc.UploadedAt.ToString("MMM d, yyyy")</td>
                                <td class="cell-actions">
                                    <div class="doc-row-actions">
                                        @if (doc.DocumentType is "PAR" or "ICS")
                                        {
                                            var isReturned = doc.ReturnedOn is not null;
                                            <button type="button" role="switch" aria-checked="@(isReturned ? "true" : "false")"
                                                    class="act ret-switch @(isReturned ? "is-on" : "")"
                                                    title="@(isReturned ? "Returned. Turn off if it wasn't returned." : "Turn on when the property is returned, then upload its Return Slip.")"
                                                    @onclick="() => ToggleReturnedAsync(doc)">
                                                <span class="ret-track" aria-hidden="true"><span class="ret-knob"></span></span>@(isReturned ? "Returned" : "Not returned")
                                            </button>
                                        }
                                        <div class="icon-acts" role="group" aria-label="@($"Actions for {doc.OriginalFileName}")">
                                            <a class="iact" href="/documents/view/@doc.DocumentId" target="_blank" rel="noopener" title="View" aria-label="@($"View {doc.OriginalFileName}")"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                            <a class="iact" href="/documents/download/@doc.DocumentId" title="Download" aria-label="@($"Download {doc.OriginalFileName}")"><i class="bi bi-download" aria-hidden="true"></i></a>
                                            <button type="button" class="iact" title="Edit" aria-label="@($"Edit {doc.OriginalFileName}")" @onclick="() => OpenEditAsync(doc)"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                            @if (doc.DocumentType is "PAR" or "ICS")
                                            {
                                                <button type="button" class="iact" title="Property on this @doc.DocumentType" aria-label="@($"Property on {doc.OriginalFileName}")" @onclick="() => OpenItemsAsync(doc)"><i class="bi bi-box-seam" aria-hidden="true"></i></button>
                                            }
                                            <button type="button" class="iact is-danger" title="Delete" aria-label="@($"Delete {doc.OriginalFileName}")" @onclick="() => DeleteAsync(doc)"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="_results.Count" @bind-Page="_page" ResetKey="@($"{_fOfficeId}|{_fType}|{_fPropertyTypeId}|{_fPersonnelId}|{_fEquip}")" Label="Document pages" />
        }
    </section>
</div>

<Dialog Show="_uploadOpen" Title="@(_returnFor is null ? "Upload property document" : "Upload the return slip")" Icon="@(_returnFor is null ? "bi-cloud-arrow-up" : "bi-arrow-return-left")" Busy="_uploading" OnClose="() => _uploadOpen = false">
    <ChildContent>
        @if (_returnFor is not null)
        {
            <div class="return-for">
                <i class="bi bi-arrow-return-left" aria-hidden="true"></i>
                <div>
                    <strong>Returning the property on this @_returnFor.DocumentType</strong>
                    <span>@_returnFor.Personnel?.FullName, @_returnFor.Office?.OfficeAcronym · @_returnFor.OriginalFileName</span>
                    <span>It is marked as Returned once its signed Return Slip is uploaded.</span>
                </div>
            </div>
        }
        <div class="field">
            <label class="form-label" for="u-office">Office</label>
            <Picker TValue="int" Id="u-office" Options="@(OfficeOptions("Select an office"))" Disabled="@(_returnFor is not null)"
                    @bind-Value="_uOfficeId" @bind-Value:after="OnUploadOfficeChangedAsync" />
        </div>
        <div class="field">
            <label class="form-label" for="u-person">RO personnel</label>
            <Picker TValue="int" Id="u-person" Disabled="@(_returnFor is not null || _uOfficeId == 0 || _uPersonnel.Count == 0)"
                    Options="@(PersonnelOptions(_uPersonnel, _uOfficeId == 0 ? "Choose an office first" : _uPersonnel.Count == 0 ? "No personnel in this office yet" : "Select a person"))"
                    @bind-Value="_uPersonnelId" @bind-Value:after="LoadUploadCandidatesAsync" />
        </div>
        <div class="field">
            <label class="form-label" for="u-type">Document</label>
            <Picker TValue="string" Id="u-type" Options="@(DocTypeOptions("Select a document"))" Disabled="@(_returnFor is not null)"
                    @bind-Value="_uType" @bind-Value:after="OnUploadTypeChanged" />
        </div>
        @if (_returnFor is null)
        {
            <div class="field">
                <label class="form-label" for="u-equip">Equipment on this document</label>
                <EquipmentPicker Id="u-equip" Multiple="true" Values="_uEquip" />
                <div class="form-text">What the @(_uType == "" ? "document" : _uType) covers: Laptop, Printer, Office chair… Add each kind if it lists several. Not in the list? Choose "Other" and type it.</div>
            </div>
        }
        <div class="row gx-3 field">
        <div class="col-sm-6">
            <label class="form-label" for="u-ptype">Type of property</label>
            <Picker TValue="int" Id="u-ptype" Disabled="@(_uType != "Return Slip" || _returnFor is not null)"
                    Options="@(PropertyTypeOptions(_uType == "" ? "Select the document first" : "Select a type"))"
                    @bind-Value="_uPropertyTypeId" />
            <div class="form-text">
                @(_uType switch
                {
                    "PAR" => "PAR is always for Property, Plant and Equipment.",
                    "ICS" => "ICS is always for Semi-Expendable property.",
                    "Return Slip" => "Choose the type of property being returned.",
                    _ => "Set automatically for PAR and ICS.",
                })
            </div>
        </div>
        <div class="col-sm-6 mt-3 mt-sm-0">
            <label class="form-label" for="u-signed">Date signed</label>
            <DatePicker Id="u-signed" @bind-Value="_uDateSigned" Max="PhTime.Now.Date" Placeholder="Select the date signed" />
            <div class="form-text">The date on the signed @(_uType == "" ? "document" : _uType).</div>
        </div>
        </div>
        <div class="field">
            <label class="form-label" for="u-file">PDF file</label>
            <InputFile id="u-file" class="form-control" OnChange="OnFileSelected" accept=".pdf,application/pdf" />
            <div class="form-text">Scanned copy signed by the AMS Chief and the end user. PDF only, up to 50 MB.</div>
        </div>
        @if (_returnFor is null && _uType is "PAR" or "ICS" && _uPersonnelId != 0)
        {
            <div class="field">
                <DocumentItemsPicker Candidates="_uCandidates" Selected="_uItems" Label="@($"Property on this {_uType}")"
                                     PersonName="@_uPersonnel.FirstOrDefault(p => p.PersonnelId == _uPersonnelId)?.FullName"
                                     PropertyTypeName="@(_uType == "PAR" ? "PPE" : "semi-expendable property")" />
                <div class="form-text">Tick the items written on the @_uType. When it's returned, they change to Returned in the register.</div>
            </div>
        }
        else if (_returnFor is not null && _returnSummary is { } rs)
        {
            <p class="form-text mb-3"><i class="bi bi-box-seam me-1" aria-hidden="true"></i>The @rs.Items @(rs.Items == 1 ? "item" : "items") on this @_returnFor.DocumentType (₱@rs.Total.ToString("N2")) will change to <strong>Returned</strong> in the property register.</p>
        }

        @if (_uploadError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_uploadError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _uploadOpen = false" disabled="@_uploading">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="UploadAsync" disabled="@_uploading">
            @if (_uploading) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> <span>Uploading…</span> }
            else { <span>@(_returnFor is null ? "Upload document" : "Upload and mark as returned")</span> }
        </button>
    </Footer>
</Dialog>

<Dialog Show="_dateDoc is not null" Title="Date signed" Icon="bi-calendar-check" Size="sm" Busy="_dateSaving" OnClose="() => _dateDoc = null">
    <ChildContent>
        @if (_dateDoc is not null)
        {
            <p class="mb-3">
                <span class="badge-pill @TypeBadge(_dateDoc.DocumentType)">@_dateDoc.DocumentType</span>
                <span class="ms-1">@_dateDoc.Personnel?.FullName</span>
                <span class="cell-sub text-truncate" title="@_dateDoc.OriginalFileName">@_dateDoc.OriginalFileName</span>
            </p>
            <div class="field mb-0">
                <label class="form-label" for="d-signed">Date signed</label>
                <DatePicker Id="d-signed" @bind-Value="_dateValue" Max="PhTime.Now.Date" Placeholder="Select the date signed" />
            </div>
            @if (_dateError is not null)
            {
                <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_dateError</div>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _dateDoc = null" disabled="@_dateSaving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveDateSignedAsync" disabled="@_dateSaving">Save date</button>
    </Footer>
</Dialog>

<Dialog Show="_itemsDoc is not null" Title="@($"Property on this {_itemsDoc?.DocumentType}")" Icon="bi-box-seam" Size="lg" Busy="_itemsSaving" OnClose="() => _itemsDoc = null">
    <ChildContent>
        @if (_itemsDoc is not null)
        {
            <p class="mb-3">
                <span class="badge-pill @TypeBadge(_itemsDoc.DocumentType)">@_itemsDoc.DocumentType</span>
                <span class="ms-1 cell-strong d-inline">@_itemsDoc.Personnel?.FullName</span>, @_itemsDoc.Office?.OfficeAcronym
                <span class="cell-sub text-truncate" title="@_itemsDoc.OriginalFileName">@_itemsDoc.OriginalFileName</span>
            </p>
            @if (_itemsDoc.ReturnedOn is not null)
            {
                <p class="form-text mb-3"><i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>This @_itemsDoc.DocumentType was returned, so items you add here are marked Returned.</p>
            }
            <DocumentItemsPicker Candidates="_itemsCandidates" Selected="_itemsSelected" Label="Tick the items written on the document"
                                 PersonName="@_itemsDoc.Personnel?.FullName"
                                 PropertyTypeName="@(_itemsDoc.DocumentType == "PAR" ? "PPE" : "semi-expendable property")"
                                 EmptyHint="e-SRS shows no value for this document." />
            @if (_itemsError is not null)
            {
                <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_itemsError</div>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _itemsDoc = null" disabled="@_itemsSaving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveItemsAsync" disabled="@_itemsSaving">Save property</button>
    </Footer>
</Dialog>

<Dialog Show="_editDoc is not null" Title="@($"Edit {_editDoc?.DocumentType}")" Icon="bi-pencil-square" Size="lg" Busy="_editSaving" OnClose="() => _editDoc = null">
    <ChildContent>
        @if (_editDoc is not null)
        {
            <p class="mb-3">
                <span class="badge-pill @TypeBadge(_editDoc.DocumentType)">@_editDoc.DocumentType</span>
                <span class="cell-sub text-truncate" title="@_editDoc.OriginalFileName">@_editDoc.OriginalFileName</span>
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label" for="e-office">Office</label>
                    <Picker TValue="int" Id="e-office" Options="@(OfficeOptions("Select an office"))" @bind-Value="_eOfficeId" @bind-Value:after="OnEditOfficeChangedAsync" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="e-person">RO personnel</label>
                    <Picker TValue="int" Id="e-person" Disabled="@(_eOfficeId == 0 || _ePersonnel.Count == 0)"
                            Options="@(PersonnelOptions(_ePersonnel, _eOfficeId == 0 ? "Choose an office first" : _ePersonnel.Count == 0 ? "No personnel in this office yet" : "Select a person"))"
                            @bind-Value="_ePersonnelId" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="e-equip">Equipment on this document</label>
                    <EquipmentPicker Id="e-equip" Multiple="true" Values="_eEquip" />
                </div>
                @if (_editDoc.DocumentType == "Return Slip")
                {
                    <div class="col-sm-6">
                        <label class="form-label" for="e-ptype">Type of property</label>
                        <Picker TValue="int" Id="e-ptype" Options="@(PropertyTypeOptions("Select a type"))" @bind-Value="_ePropertyTypeId" />
                    </div>
                }
                <div class="col-sm-6">
                    <label class="form-label" for="e-signed">Date signed</label>
                    <DatePicker Id="e-signed" @bind-Value="_eDateSigned" Max="PhTime.Now.Date" Placeholder="Select the date signed" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="e-file">Replace the PDF <span class="text-muted-2 fw-normal">(optional)</span></label>
                    <InputFile id="e-file" class="form-control" OnChange="OnEditFileSelected" accept=".pdf,application/pdf" />
                    <div class="form-text">Only if a better scan or the wrong file was uploaded.</div>
                </div>
            </div>
            @if (_editDoc.ReturnedOn is null && _editDoc.DocumentType is "PAR" or "ICS" && _ePersonnelId != 0 && _ePersonnelId != _editDoc.PersonnelId && _summaries.TryGetValue(_editDoc.DocumentId, out var es))
            {
                <p class="form-text mt-3 mb-0"><i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>The @es.Items @(es.Items == 1 ? "item" : "items") on this @_editDoc.DocumentType move to the new person in the property register too.</p>
            }
            @if (_editError is not null)
            {
                <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_editError</div>
            }
            <p class="small text-muted-2 mt-3 mb-0">To change the kind of document (PAR, ICS or Return Slip), delete it and upload it again.</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _editDoc = null" disabled="@_editSaving">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_editSaving">
            @if (_editSaving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
            Save changes
        </button>
    </Footer>
</Dialog>

@code {
    private sealed record DocType(string Code, string Label, string Icon, string Tone);
    private static readonly DocType[] DocTypes =
    [
        new("PAR", "Property Acknowledgement Receipt (PAR)", "bi-file-earmark-check", ""),
        new("ICS", "Inventory Custodian Slip (ICS)", "bi-file-earmark-text", "is-gold"),
        new("Return Slip", "Return Slip", "bi-arrow-return-left", "is-ok"),
    ];

    private const long MaxFileSizeBytes = 50 * 1024 * 1024;

    private List<Office> _offices = [];
    private List<PropertyType> _propertyTypes = [];
    private Dictionary<string, int> _counts = new();
    private List<PropertyDocument>? _results;
    private readonly HashSet<int> _selected = [];
    private int _page = 1;
    private PropertyDocument? _returnFor;   // the PAR / ICS the Return Slip is being uploaded for

    private int _fOfficeId, _fPropertyTypeId, _fPersonnelId;
    private string _fType = "";
    private List<RoPersonnel> _fPersonnel = [];

    private bool _uploadOpen, _uploading;
    private int _uOfficeId, _uPersonnelId, _uPropertyTypeId;
    private string _uType = "";
    private DateTime? _uDateSigned;
    private List<RoPersonnel> _uPersonnel = [];
    private IBrowserFile? _file;
    private string? _uploadError;
    private List<LinkCandidate>? _uCandidates;
    private List<string> _uEquip = [];
    private string _fEquip = "";
    private List<string> _knownEquipment = [];
    private readonly HashSet<int> _uItems = [];
    private LinkedSummary? _returnSummary;   // the property on the PAR / ICS being returned

    private Dictionary<int, LinkedSummary> _summaries = new();
    private PropertyDocument? _itemsDoc;
    private List<LinkCandidate>? _itemsCandidates;
    private HashSet<int> _itemsSelected = [];
    private bool _itemsSaving;
    private string? _itemsError;

    // Options for the <Picker> dropdowns (the first one is "all" or "select")
    private IReadOnlyList<PickOption<int>> OfficeOptions(string first) =>
        [new(0, first), .. _offices.Select(o => new PickOption<int>(o.OfficeId, o.OfficeAcronym, o.OfficeName))];

    private static IReadOnlyList<PickOption<string>> DocTypeOptions(string first) =>
        [new("", first), .. DocTypes.Select(t => new PickOption<string>(t.Code, t.Label))];

    private IReadOnlyList<PickOption<int>> PropertyTypeOptions(string first) =>
        [new(0, first), .. _propertyTypes.Select(t => new PickOption<int>(t.PropertyTypeId, t.TypeName))];

