@page "/property-documents"
@layout AppLayout
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PropertyDocumentStorage Storage
@inject AuthenticationStateProvider AuthStateProvider
@inject ModalService Modal
@inject IJSRuntime JS
@inject ILogger<PropertyDocuments> Log

<PageTitle>Property documents | AMS StockWatch</PageTitle>

<PageHeader Title="Property documents" Subtitle="Signed PAR, ICS and return slips for Regional Office personnel.">
    <Actions>
        <button type="button" class="btn btn-accent" @onclick="OpenUpload">
            <i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i> Upload document
        </button>
    </Actions>
</PageHeader>

<div class="wrap page-body">
    <div class="stat-grid">
        @foreach (var t in DocTypes)
        {
            <button type="button" class="stat @(_fType == t.Code ? "is-active" : "")" @onclick="() => ToggleTypeAsync(t.Code)">
                <span class="stat-icon @t.Tone"><i class="bi @t.Icon" aria-hidden="true"></i></span>
                <span><span class="stat-value">@_counts.GetValueOrDefault(t.Code)</span><span class="stat-label">@t.Label</span></span>
            </button>
        }
    </div>

    <section class="panel">
        <div class="panel-body">
            <div class="filters">
                <div>
                    <label class="form-label" for="f-office">Office</label>
                    <select id="f-office" class="form-select" @bind="_fOfficeId" @bind:after="OnFilterOfficeChangedAsync">
                        <option value="0">All offices</option>
                        @foreach (var o in _offices)
                        {
                            <option value="@o.OfficeId">@o.OfficeAcronym, @o.OfficeName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="f-type">Document</label>
                    <select id="f-type" class="form-select" @bind="_fType" @bind:after="RunFilterAsync">
                        <option value="">All documents</option>
                        @foreach (var t in DocTypes)
                        {
                            <option value="@t.Code">@t.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="f-ptype">Type of property</label>
                    <select id="f-ptype" class="form-select" @bind="_fPropertyTypeId" @bind:after="RunFilterAsync">
                        <option value="0">All types</option>
                        @foreach (var t in _propertyTypes)
                        {
                            <option value="@t.PropertyTypeId">@t.TypeName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="f-person">RO personnel</label>
                    <select id="f-person" class="form-select" @bind="_fPersonnelId" @bind:after="RunFilterAsync" disabled="@(_fOfficeId == 0)">
                        <option value="0">@(_fOfficeId == 0 ? "Choose an office first" : "Everyone in this office")</option>
                        @foreach (var p in _fPersonnel)
                        {
                            <option value="@p.PersonnelId">@p.FullName, @p.Position</option>
                        }
                    </select>
                </div>
            </div>
            @if (HasFilters)
            {
                <div class="filters-actions">
                    <button type="button" class="btn btn-light btn-sm" @onclick="ClearFiltersAsync"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Clear filters</button>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <header class="panel-head">
            <h2>@(_results is null ? "Documents" : $"{_results.Count} {(_results.Count == 1 ? "document" : "documents")}")</h2>
            @if (_selected.Count > 0)
            {
                <a class="btn btn-outline-primary btn-sm" href="@BulkDownloadUrl" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-zip me-1" aria-hidden="true"></i> Download selected (@_selected.Count)
                </a>
            }
        </header>

        @if (_results is null)
        {
            <div class="loading">Loading documents…</div>
        }
        else if (_results.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <h2>@(HasFilters ? "No documents match these filters" : "No documents uploaded yet")</h2>
                <p>@(HasFilters ? "Try clearing a filter." : "Upload signed PAR, ICS or return slips as PDF files.")</p>
                @if (!HasFilters)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenUpload">Upload document</button>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="cell-check">
                                <input class="form-check-input" type="checkbox" aria-label="Select all"
                                       checked="@(_selected.Count == _results.Count)" @onchange="ToggleAll" />
                            </th>
                            <th>Document</th><th>Type of property</th><th>Office</th><th>RO personnel</th><th>Uploaded</th><th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _results)
                        {
                            <tr @key="doc.DocumentId">
                                <td class="cell-check">
                                    <input class="form-check-input" type="checkbox" aria-label="@($"Select {doc.OriginalFileName}")"
                                           checked="@_selected.Contains(doc.DocumentId)"
                                           @onchange="e => ToggleOne(doc.DocumentId, e.Value is true)" />
                                </td>
                                <td>
                                    <span class="badge-pill @TypeBadge(doc.DocumentType)">@doc.DocumentType</span>
                                    <span class="cell-sub text-truncate" style="max-width: 260px" title="@doc.OriginalFileName">@doc.OriginalFileName</span>
                                </td>
                                <td>@doc.PropertyType?.TypeName</td>
                                <td>@doc.Office?.OfficeAcronym</td>
                                <td><span class="cell-strong">@doc.Personnel?.FullName</span><span class="cell-sub">@doc.Personnel?.Position</span></td>
                                <td class="text-nowrap">@doc.UploadedAt.ToString("MMM d, yyyy")</td>
                                <td>
                                    <div class="row-actions justify-content-end">
                                        <a class="act" href="/documents/view/@doc.DocumentId" target="_blank" rel="noopener"><i class="bi bi-eye" aria-hidden="true"></i>View</a>
                                        <a class="act" href="/documents/download/@doc.DocumentId"><i class="bi bi-download" aria-hidden="true"></i>Download</a>
                                        <button type="button" class="act is-danger" @onclick="() => DeleteAsync(doc)"><i class="bi bi-trash3" aria-hidden="true"></i>Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<Dialog Show="_uploadOpen" Title="Upload property document" Icon="bi-cloud-arrow-up" Busy="_uploading" OnClose="() => _uploadOpen = false">
    <ChildContent>
        <div class="field">
            <label class="form-label" for="u-office">Office</label>
            <select id="u-office" class="form-select" @bind="_uOfficeId" @bind:after="OnUploadOfficeChangedAsync">
                <option value="0">Select an office</option>
                @foreach (var o in _offices)
                {
                    <option value="@o.OfficeId">@o.OfficeAcronym, @o.OfficeName</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="form-label" for="u-person">RO personnel</label>
            <select id="u-person" class="form-select" @bind="_uPersonnelId" disabled="@(_uOfficeId == 0)">
                <option value="0">@(_uOfficeId == 0 ? "Choose an office first" : _uPersonnel.Count == 0 ? "No personnel in this office yet" : "Select a person")</option>
                @foreach (var p in _uPersonnel)
                {
                    <option value="@p.PersonnelId">@p.FullName, @p.Position</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="form-label" for="u-type">Document</label>
            <select id="u-type" class="form-select" @bind="_uType" @bind:after="OnUploadTypeChanged">
                <option value="">Select a document</option>
                @foreach (var t in DocTypes)
                {
                    <option value="@t.Code">@t.Label</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="form-label" for="u-ptype">Type of property</label>
            <select id="u-ptype" class="form-select" @bind="_uPropertyTypeId" disabled="@(_uType != "Return Slip")">
                <option value="0">@(_uType == "" ? "Select the document first" : "Select a type")</option>
                @foreach (var t in _propertyTypes)
                {
                    <option value="@t.PropertyTypeId">@t.TypeName</option>
                }
            </select>
            <div class="form-text">
                @(_uType switch
                {
                    "PAR" => "PAR is always for Property, Plant and Equipment.",
                    "ICS" => "ICS is always for Semi-Expendable property.",
                    "Return Slip" => "Choose the type of property being returned.",
                    _ => "Set automatically for PAR and ICS.",
                })
            </div>
        </div>
        <div class="field">
            <label class="form-label" for="u-file">PDF file</label>
            <InputFile id="u-file" class="form-control" OnChange="OnFileSelected" accept=".pdf,application/pdf" />
            <div class="form-text">Scanned copy signed by the AMS Chief and the end user. PDF only, up to 50 MB.</div>
        </div>

        @if (_uploadError is not null)
        {
            <div class="form-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_uploadError</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => _uploadOpen = false" disabled="@_uploading">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="UploadAsync" disabled="@_uploading">
            @if (_uploading) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> <span>Uploading…</span> }
            else { <span>Upload document</span> }
        </button>
    </Footer>
</Dialog>

@code {
    private sealed record DocType(string Code, string Label, string Icon, string Tone);
    private static readonly DocType[] DocTypes =
    [
        new("PAR", "Property Acknowledgement Receipt (PAR)", "bi-file-earmark-check", ""),
        new("ICS", "Inventory Custodian Slip (ICS)", "bi-file-earmark-text", "is-gold"),
        new("Return Slip", "Return Slip", "bi-arrow-return-left", "is-ok"),
    ];

    private const long MaxFileSizeBytes = 50 * 1024 * 1024;

    private List<Office> _offices = [];
    private List<PropertyType> _propertyTypes = [];
    private Dictionary<string, int> _counts = new();
    private List<PropertyDocument>? _results;
    private readonly HashSet<int> _selected = [];

    private int _fOfficeId, _fPropertyTypeId, _fPersonnelId;
    private string _fType = "";
    private List<RoPersonnel> _fPersonnel = [];

    private bool _uploadOpen, _uploading;
    private int _uOfficeId, _uPersonnelId, _uPropertyTypeId;
    private string _uType = "";
    private List<RoPersonnel> _uPersonnel = [];
    private IBrowserFile? _file;
    private string? _uploadError;

    private bool HasFilters => _fOfficeId != 0 || _fType != "" || _fPropertyTypeId != 0 || _fPersonnelId != 0;
    private string BulkDownloadUrl => "/documents/download-bulk?ids=" + string.Join(",", _selected);

    private static string TypeBadge(string type) => type switch
    {
        "PAR" => "badge-navy",
        "ICS" => "badge-gold",
        _ => "badge-ok",
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _offices = await db.Offices.AsNoTracking().OrderBy(o => o.OfficeAcronym).ToListAsync();
        _propertyTypes = await db.PropertyTypes.AsNoTracking().OrderBy(t => t.TypeName).ToListAsync();
        await LoadCountsAsync();
        await RunFilterAsync();
    }

    private async Task LoadCountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _counts = await db.PropertyDocuments.GroupBy(d => d.DocumentType)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);
    }

    private async Task RunFilterAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.PropertyDocuments.AsNoTracking()
            .Include(d => d.Office).Include(d => d.PropertyType).Include(d => d.Personnel)
            .AsQueryable();
        if (_fOfficeId != 0) q = q.Where(d => d.OfficeId == _fOfficeId);
        if (_fType != "") q = q.Where(d => d.DocumentType == _fType);
        if (_fPropertyTypeId != 0) q = q.Where(d => d.PropertyTypeId == _fPropertyTypeId);
        if (_fPersonnelId != 0) q = q.Where(d => d.PersonnelId == _fPersonnelId);

        _results = await q.OrderByDescending(d => d.UploadedAt).ToListAsync();
        _selected.IntersectWith(_results.Select(r => r.DocumentId));
    }

    private async Task OnFilterOfficeChangedAsync()
    {
        _fPersonnelId = 0;
        _fPersonnel = await PersonnelOfAsync(_fOfficeId);
        await RunFilterAsync();
    }

    private Task ToggleTypeAsync(string code)
    {
        _fType = _fType == code ? "" : code;
        return RunFilterAsync();
    }

    private Task ClearFiltersAsync()
    {
        _fOfficeId = _fPropertyTypeId = _fPersonnelId = 0;
        _fType = "";
        _fPersonnel = [];
        return RunFilterAsync();
    }

    private void ToggleOne(int id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true && _results is not null) _selected.UnionWith(_results.Select(r => r.DocumentId));
    }

    private async Task<List<RoPersonnel>> PersonnelOfAsync(int officeId)
    {
        if (officeId == 0) return [];
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.RoPersonnel.AsNoTracking().Where(p => p.OfficeId == officeId).OrderBy(p => p.FullName).ToListAsync();
    }

    // ── Delete ──────────────────────────────────────────────────────────
    private async Task DeleteAsync(PropertyDocument doc)
    {
        var ok = await Modal.ConfirmAsync("Delete this document?",
            $"{doc.DocumentType} for {doc.Personnel?.FullName} ({doc.OriginalFileName}) will be permanently deleted, including the PDF file.",
            "Delete document", "Cancel", ModalVariant.Danger);
        if (!ok) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(doc.DocumentId);
            if (row is not null)
            {
                db.PropertyDocuments.Remove(row);
                await db.SaveChangesAsync();                 // record first…
                var path = Path.Combine(Storage.RootPath, Path.GetFileName(row.FilePath));
                if (File.Exists(path)) File.Delete(path);    // …then the file, so a failed save never orphans the record
            }
            _selected.Remove(doc.DocumentId);
            await LoadCountsAsync();
            await RunFilterAsync();
            await Toast("Document deleted.", "danger");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting document {Id} failed", doc.DocumentId);
            await Modal.ErrorAsync("Couldn't delete the document", "Check your connection and try again.");
        }
    }

    // ── Upload ──────────────────────────────────────────────────────────
    private void OpenUpload()
    {
        _uOfficeId = _fOfficeId;
        _uPersonnelId = _uPropertyTypeId = 0;
        _uType = "";
        _uPersonnel = _fPersonnel;
        _file = null;
        _uploadError = null;
        _uploadOpen = true;
    }

    private async Task OnUploadOfficeChangedAsync()
    {
        _uPersonnelId = 0;
        _uPersonnel = await PersonnelOfAsync(_uOfficeId);
    }

    private void OnUploadTypeChanged()
    {
        _uploadError = null;
        _uPropertyTypeId = _uType == "Return Slip" ? 0 : AutoPropertyType(_uType);
        if (_uType is "PAR" or "ICS" && _uPropertyTypeId == 0)
            _uploadError = "The matching Type of Property isn't in the database. Check the property types list.";
    }

    private int AutoPropertyType(string docType) => docType switch
    {
        "ICS" => FindType("Semi-Expendable", "Semi Expendable", "(SE)"),
        "PAR" => FindType("Property, Plant", "Property Plant", "(PPE)"),
        _ => 0,
    };

    private int FindType(params string[] keywords) =>
        _propertyTypes.FirstOrDefault(t => keywords.Any(k => t.TypeName.Contains(k, StringComparison.OrdinalIgnoreCase)))?.PropertyTypeId ?? 0;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _file = null;
        if (!e.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            _uploadError = "Only PDF files can be uploaded.";
        else if (e.File.Size > MaxFileSizeBytes)
            _uploadError = $"This file is {e.File.Size / 1024.0 / 1024.0:F1} MB. The limit is 50 MB.";
        else
            _file = e.File;
    }

    private async Task UploadAsync()
    {
        _uploadError = null;
        if (_uType is "PAR" or "ICS") _uPropertyTypeId = AutoPropertyType(_uType);

        _uploadError = (_uOfficeId, _uPersonnelId, _uType, _uPropertyTypeId, _file) switch
        {
            (0, _, _, _, _) => "Select the office.",
            (_, 0, _, _, _) => "Select the RO personnel.",
            (_, _, "", _, _) => "Select the document.",
            (_, _, _, 0, _) => "Select the type of property.",
            (_, _, _, _, null) => "Attach the signed PDF.",
            _ => null,
        };
        if (_uploadError is not null) return;

        _uploading = true;
        var storedName = $"{Guid.NewGuid()}.pdf";
        var fullPath = Path.Combine(Storage.RootPath, storedName);
        try
        {
            await using (var target = new FileStream(fullPath, FileMode.CreateNew))
            await using (var source = _file!.OpenReadStream(maxAllowedSize: MaxFileSizeBytes))
                await source.CopyToAsync(target);

            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.PropertyDocuments.Add(new PropertyDocument
            {
                OfficeId = _uOfficeId,
                DocumentType = _uType,
                PropertyTypeId = _uPropertyTypeId,
                PersonnelId = _uPersonnelId,
                FilePath = storedName,
                OriginalFileName = Path.GetFileName(_file.Name),
                UploadedBy = userId,
                UploadedAt = PhTime.Now,
            });
            await db.SaveChangesAsync();

            _uploadOpen = false;
            await LoadCountsAsync();
            await RunFilterAsync();
            await Toast($"{_uType} uploaded.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Upload failed");
            if (File.Exists(fullPath)) File.Delete(fullPath);   // no orphaned files
            _uploadError = "The upload didn't finish. Check your connection and try again.";
        }
        finally { _uploading = false; }
    }

    private ValueTask Toast(string text, string type = "success") => JS.InvokeVoidAsync("showToast", text, type);
}
