    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _offices = await db.Offices.AsNoTracking().OrderBy(o => o.OfficeAcronym).ToListAsync();
        _propertyTypes = await db.PropertyTypes.AsNoTracking().OrderBy(t => t.TypeName).ToListAsync();
        await LoadCountsAsync();
        await RunFilterAsync();
    }

    private async Task LoadCountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _counts = await db.PropertyDocuments.GroupBy(d => d.DocumentType)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);
    }

    private async Task RunFilterAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.PropertyDocuments.AsNoTracking()
            .Include(d => d.Office).Include(d => d.PropertyType).Include(d => d.Personnel)
            .AsQueryable();
        if (_fOfficeId != 0) q = q.Where(d => d.OfficeId == _fOfficeId);
        if (_fType != "") q = q.Where(d => d.DocumentType == _fType);
        if (_fPropertyTypeId != 0) q = q.Where(d => d.PropertyTypeId == _fPropertyTypeId);
        if (_fPersonnelId != 0) q = q.Where(d => d.PersonnelId == _fPersonnelId);
        if (_fEquip != "") q = q.Where(d => d.EquipmentType != null && d.EquipmentType.Contains(_fEquip));

        _results = await q.OrderByDescending(d => d.UploadedAt).ToListAsync();
        _selected.IntersectWith(_results.Select(r => r.DocumentId));
        _knownEquipment = (await db.PropertyDocuments.AsNoTracking().Where(d => d.EquipmentType != null).Select(d => d.EquipmentType).Distinct().ToListAsync())
            .SelectMany(PropertyStatus.SplitEquipment).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(e => e).ToList();
        _summaries = await Links.SummariesAsync(_results.Where(r => r.DocumentType is "PAR" or "ICS").Select(r => r.DocumentId).ToList());
    }

    private async Task OnFilterOfficeChangedAsync()
    {
        _fPersonnelId = 0;
        _fPersonnel = await PersonnelOfAsync(_fOfficeId);
        await RunFilterAsync();
    }

    private Task ToggleTypeAsync(string code)
    {
        _fType = _fType == code ? "" : code;
        return RunFilterAsync();
    }

    private Task ClearFiltersAsync()
    {
        _fOfficeId = _fPropertyTypeId = _fPersonnelId = 0;
        _fType = _fEquip = "";
        _fPersonnel = [];
        return RunFilterAsync();
    }

    private void ToggleOne(int id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true && _results is not null) _selected.UnionWith(_results.Select(r => r.DocumentId));
    }

    private async Task<List<RoPersonnel>> PersonnelOfAsync(int officeId)
    {
        if (officeId == 0) return [];
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.RoPersonnel.AsNoTracking().Where(p => p.OfficeId == officeId).OrderBy(p => p.FullName).ToListAsync();
    }

    // Delete
    private async Task DeleteAsync(PropertyDocument doc)
    {
        var ok = await Modal.ConfirmAsync("Delete this document?",
            $"{doc.DocumentType} for {doc.Personnel?.FullName} ({doc.OriginalFileName}) will be permanently deleted, including the PDF file.",
            "Delete document", "Cancel", ModalVariant.Danger);
        if (!ok) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(doc.DocumentId);
            if (row is not null)
            {
                db.PropertyDocuments.Remove(row);
                // If the Return Slip is deleted, there's no proof of the return anymore, so its PAR / ICS goes back to "not returned".
                var returnedBy = await db.PropertyDocuments.Where(d => d.ReturnSlipId == row.DocumentId).ToListAsync();
                foreach (var d in returnedBy) { d.ReturnSlipId = null; d.ReturnedOn = null; }
                await Links.UndoReturnAsync(db, returnedBy.Select(d => d.DocumentId).ToList());   // their property is back with the person
                await db.SaveChangesAsync();                 // record first...
                var path = Path.Combine(Storage.RootPath, Path.GetFileName(row.FilePath));
                if (File.Exists(path)) File.Delete(path);    // ...then the file, so a failed save never leaves a record without a file
            }
            _selected.Remove(doc.DocumentId);
            await LoadCountsAsync();
            await RunFilterAsync();
            await Toast("Document deleted.", "danger");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting document {Id} failed", doc.DocumentId);
            await Modal.ErrorAsync("Couldn't delete the document", "Check your connection and try again.");
        }
    }

    // Upload
    private void OpenUpload()
    {
        _returnFor = null;
        _uOfficeId = _fOfficeId;
        _uPersonnelId = _uPropertyTypeId = 0;
        _uType = "";
        _uDateSigned = null;
        _uPersonnel = _fPersonnel;
        _file = null;
        _uploadError = null;
        _uCandidates = null;
        _uItems.Clear();
        _uEquip = [];
        _returnSummary = null;
        _uploadOpen = true;
    }

    private async Task OnUploadOfficeChangedAsync()
    {
        _uPersonnelId = 0;
        _uPersonnel = await PersonnelOfAsync(_uOfficeId);
        await LoadUploadCandidatesAsync();
    }

    private async Task OnUploadTypeChanged()
    {
        _uploadError = null;
        _uPropertyTypeId = _uType == "Return Slip" ? 0 : AutoPropertyType(_uType);
        if (_uType is "PAR" or "ICS" && _uPropertyTypeId == 0)
            _uploadError = "The matching Type of Property isn't in the database. Check the property types list.";
        await LoadUploadCandidatesAsync();
    }

    // The register items that can be put on the PAR / ICS being uploaded
    private async Task LoadUploadCandidatesAsync()
    {
        _uItems.Clear();
        _uCandidates = null;
        if (_returnFor is not null || _uType is not ("PAR" or "ICS") || _uPersonnelId == 0) return;
        var typeId = AutoPropertyType(_uType);
        if (typeId == 0) return;
        _uCandidates = await Links.CandidatesAsync(typeId, _uPersonnelId, null);
    }

    private int AutoPropertyType(string docType) => docType switch
    {
        "ICS" => FindType("Semi-Expendable", "Semi Expendable", "(SE)"),
        "PAR" => FindType("Property, Plant", "Property Plant", "(PPE)"),
        _ => 0,
    };

    private int FindType(params string[] keywords) =>
        _propertyTypes.FirstOrDefault(t => keywords.Any(k => t.TypeName.Contains(k, StringComparison.OrdinalIgnoreCase)))?.PropertyTypeId ?? 0;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _file = null;
        if (!e.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            _uploadError = "Only PDF files can be uploaded.";
        else if (e.File.Size > MaxFileSizeBytes)
            _uploadError = $"This file is {e.File.Size / 1024.0 / 1024.0:F1} MB. The limit is 50 MB.";
        else
            _file = e.File;
    }

    private async Task UploadAsync()
    {
        _uploadError = null;
        if (_uType is "PAR" or "ICS") _uPropertyTypeId = AutoPropertyType(_uType);

        _uploadError = (_uOfficeId, _uPersonnelId, _uType, _uPropertyTypeId, _file) switch
        {
            (0, _, _, _, _) => "Select the office.",
            (_, 0, _, _, _) => "Select the RO personnel.",
            (_, _, "", _, _) => "Select the document.",
            (_, _, _, 0, _) => "Select the type of property.",
            _ when _uDateSigned is null => "Select the date the document was signed.",
            _ when _uDateSigned.Value.Date > PhTime.Now.Date => "The date signed can't be in the future.",
            _ when _returnFor is null && _uType is "PAR" or "ICS" && _uEquip.Count == 0 => $"Choose the equipment on this {_uType} (Laptop, Printer, …).",
            (_, _, _, _, null) => "Attach the signed PDF.",
            _ => null,
        };
        if (_uploadError is not null) return;

        _uploading = true;
        var storedName = $"{Guid.NewGuid()}.pdf";
        var fullPath = Path.Combine(Storage.RootPath, storedName);
        try
        {
            await using (var target = new FileStream(fullPath, FileMode.CreateNew))
            await using (var source = _file!.OpenReadStream(maxAllowedSize: MaxFileSizeBytes))
                await source.CopyToAsync(target);

            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId);

            await using var db = await DbFactory.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            var added = new PropertyDocument
            {
                OfficeId = _uOfficeId,
                DocumentType = _uType,
                PropertyTypeId = _uPropertyTypeId,
                PersonnelId = _uPersonnelId,
                EquipmentType = _returnFor is not null ? _returnFor.EquipmentType : PropertyStatus.JoinEquipment(_uEquip),
                FilePath = storedName,
                OriginalFileName = Path.GetFileName(_file.Name),
                DateSigned = _uDateSigned!.Value.Date,
                UploadedBy = userId,
                UploadedAt = PhTime.Now,
            };
            db.PropertyDocuments.Add(added);
            await db.SaveChangesAsync();

            // The register items written on the PAR / ICS
            var linked = 0;
            if (_returnFor is null && _uType is "PAR" or "ICS" && _uItems.Count > 0)
            {
                (linked, _) = await Links.SetLinksAsync(db, added, _uItems);
                await db.SaveChangesAsync();
            }

            // Uploaded from the "Returned" switch: I mark the PAR / ICS as returned on the date of the slip,
            // and its property as Returned in the register.
            var returned = _returnFor is not null ? await db.PropertyDocuments.FindAsync(_returnFor.DocumentId) : null;
            var returnedItems = 0;
            if (returned is not null)
            {
                returned.ReturnedOn = added.DateSigned;
                returned.ReturnSlipId = added.DocumentId;
                returnedItems = await Links.MarkReturnedAsync(db, returned.DocumentId);
                await db.SaveChangesAsync();
            }
            await tx.CommitAsync();

            _uploadOpen = false;
            await LoadCountsAsync();
            await RunFilterAsync();
            await Toast(returned is not null
                ? $"Return slip uploaded. The {returned.DocumentType} is marked as returned" + (returnedItems > 0 ? $" and its {returnedItems} {(returnedItems == 1 ? "item is" : "items are")} now Returned in the register." : ".")
                : linked > 0 ? $"{_uType} uploaded with {linked} {(linked == 1 ? "item" : "items")}." : $"{_uType} uploaded.");
            _returnFor = null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Upload failed");
            if (File.Exists(fullPath)) File.Delete(fullPath);   // no leftover files
            _uploadError = "The upload didn't finish. Check your connection and try again.";
        }
        finally { _uploading = false; }
    }

    // Returned switch (PAR / ICS)
    // On: opens the upload for the Return Slip, filled in from the PAR / ICS. The document is only marked
    // as returned after the slip is uploaded. Off: asks first, and the uploaded slip stays in the list.
    private async Task ToggleReturnedAsync(PropertyDocument doc)
    {
        if (doc.ReturnedOn is null)
        {
            _returnFor = doc;
            _uOfficeId = doc.OfficeId;
            _uPersonnel = await PersonnelOfAsync(doc.OfficeId);
            _uPersonnelId = doc.PersonnelId;
            _uType = "Return Slip";
            _uPropertyTypeId = doc.PropertyTypeId;
            _uDateSigned = null;
            _file = null;
            _uploadError = null;
            _uCandidates = null;
            _uItems.Clear();
            _returnSummary = _summaries.GetValueOrDefault(doc.DocumentId);
            _uploadOpen = true;
            return;
        }

        var ok = await Modal.ConfirmAsync("Mark as not returned?",
            $"The {doc.DocumentType} for {doc.Personnel?.FullName} will show as not returned, and its property goes back to the status it had before. Its Return Slip stays in the list; delete it there if it was uploaded by mistake.",
            "Mark as not returned", "Cancel", ModalVariant.Warning);
        if (!ok) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(doc.DocumentId);
            if (row is not null)
            {
                row.ReturnedOn = null;
                row.ReturnSlipId = null;
                await Links.UndoReturnAsync(db, [row.DocumentId]);   // its property goes back to the status it had
                await db.SaveChangesAsync();
            }
            await RunFilterAsync();
            await Toast($"{doc.DocumentType} marked as not returned.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Clearing the return of document {Id} failed", doc.DocumentId);
            await Modal.ErrorAsync("Couldn't save the change", "Check your connection and try again.");
        }
    }

    // Edit a document
    private PropertyDocument? _editDoc;
    private int _eOfficeId, _ePersonnelId, _ePropertyTypeId;
    private List<RoPersonnel> _ePersonnel = [];
    private List<string> _eEquip = [];
    private DateTime? _eDateSigned;
    private IBrowserFile? _eFile;
    private bool _editSaving;
    private string? _editError;

    private async Task OpenEditAsync(PropertyDocument doc)
    {
        _editDoc = doc;
        _eOfficeId = doc.OfficeId;
        _ePersonnel = await PersonnelOfAsync(doc.OfficeId);
        _ePersonnelId = doc.PersonnelId;
        _ePropertyTypeId = doc.PropertyTypeId;
        _eEquip = PropertyStatus.SplitEquipment(doc.EquipmentType);
        _eDateSigned = doc.DateSigned;
        _eFile = null;
        _editError = null;
    }

    private async Task OnEditOfficeChangedAsync()
    {
        _ePersonnelId = 0;
        _ePersonnel = await PersonnelOfAsync(_eOfficeId);
    }

    private void OnEditFileSelected(InputFileChangeEventArgs e)
    {
        _editError = null;
        _eFile = null;
        if (!e.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) _editError = "Only PDF files can be uploaded.";
        else if (e.File.Size > MaxFileSizeBytes) _editError = $"This file is {e.File.Size / 1024.0 / 1024.0:F1} MB. The limit is 50 MB.";
        else _eFile = e.File;
    }

    private async Task SaveEditAsync()
    {
        if (_editDoc is null) return;
        _editError = _eOfficeId == 0 ? "Select the office."
            : _ePersonnelId == 0 ? "Select the RO personnel."
            : _ePropertyTypeId == 0 ? "Select the type of property."
            : _eDateSigned is null ? "Select the date the document was signed."
            : _eDateSigned.Value.Date > PhTime.Now.Date ? "The date signed can't be in the future."
            : _editDoc.DocumentType is "PAR" or "ICS" && _eEquip.Count == 0 ? $"Choose the equipment on this {_editDoc.DocumentType}."
            : null;
        if (_editError is not null) return;

        _editSaving = true;
        string? newName = null, oldName = null;
        try
        {
            if (_eFile is not null)
            {
                newName = $"{Guid.NewGuid()}.pdf";
                await using var target = new FileStream(Path.Combine(Storage.RootPath, newName), FileMode.CreateNew);
                await using var source = _eFile.OpenReadStream(maxAllowedSize: MaxFileSizeBytes);
                await source.CopyToAsync(target);
            }

            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId);

            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(_editDoc.DocumentId);
            if (row is null) { _editDoc = null; await RunFilterAsync(); return; }

            var personChanged = row.PersonnelId != _ePersonnelId || row.OfficeId != _eOfficeId;
            row.OfficeId = _eOfficeId;
            row.PersonnelId = _ePersonnelId;
            if (row.DocumentType == "Return Slip") row.PropertyTypeId = _ePropertyTypeId;
            row.EquipmentType = PropertyStatus.JoinEquipment(_eEquip);
            row.DateSigned = _eDateSigned!.Value.Date;
            if (newName is not null) { oldName = row.FilePath; row.FilePath = newName; row.OriginalFileName = Path.GetFileName(_eFile!.Name); }

            var moved = 0;
            if (personChanged && row.ReturnedOn is null && row.DocumentType is "PAR" or "ICS")
            {
                // The property on it moves with the document to the new person
                var items = await db.PropertyItems.Where(i => i.DocumentId == row.DocumentId).ToListAsync();
                foreach (var i in items) { i.PersonnelId = row.PersonnelId; i.OfficeId = row.OfficeId; }
                moved = items.Count;
            }
            await Links.FillEquipmentAsync(db, row);
            db.UserActivities.Add(new UserActivity { UserId = userId, ActivityType = "Update", Description = $"Edited {row.DocumentType} {row.OriginalFileName}", CreatedAt = PhTime.Now });
            await db.SaveChangesAsync();
            newName = null;   // saved, so keep the new file
            if (oldName is not null)
            {
                var oldPath = Path.Combine(Storage.RootPath, Path.GetFileName(oldName));
                if (File.Exists(oldPath)) File.Delete(oldPath);
            }

            var type = _editDoc.DocumentType;
            _editDoc = null;
            await RunFilterAsync();
            await Toast(moved > 0 ? $"{type} saved. Its {moved} {(moved == 1 ? "item" : "items")} moved to the new person." : $"{type} saved.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Editing document {Id} failed", _editDoc?.DocumentId);
            _editError = "Couldn't save the changes. Check your connection and try again.";
        }
        finally
        {
            if (newName is not null)
            {
                var p = Path.Combine(Storage.RootPath, newName);
                if (File.Exists(p)) File.Delete(p);   // not saved, so remove the new file
            }
            _editSaving = false;
        }
    }

    // Property on a PAR / ICS
    private async Task OpenItemsAsync(PropertyDocument doc)
    {
        _itemsDoc = doc;
        _itemsError = null;
        _itemsCandidates = null;
        _itemsSelected = await Links.LinkedIdsAsync(doc.DocumentId);
        _itemsCandidates = await Links.CandidatesAsync(doc.PropertyTypeId, doc.PersonnelId, doc.DocumentId);
    }

    private async Task SaveItemsAsync()
    {
        if (_itemsDoc is null) return;
        _itemsSaving = true;
        _itemsError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(_itemsDoc.DocumentId);
            if (row is null) { _itemsDoc = null; await RunFilterAsync(); return; }
            var (added, removed) = await Links.SetLinksAsync(db, row, _itemsSelected);
            if (added + removed > 0)
            {
                var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
                uint.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId);
                db.UserActivities.Add(new UserActivity
                {
                    UserId = userId, ActivityType = "Update", CreatedAt = PhTime.Now,
                    Description = $"Property on {row.DocumentType} {row.OriginalFileName}: {added} added, {removed} removed",
                });
            }
            await db.SaveChangesAsync();
            var type = _itemsDoc.DocumentType;
            _itemsDoc = null;
            await RunFilterAsync();
            await Toast(added + removed == 0 ? "No changes." : $"Property on the {type} saved.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the property on document {Id} failed", _itemsDoc?.DocumentId);
            _itemsError = "Couldn't save. Check your connection and try again.";
        }
        finally { _itemsSaving = false; }
    }

    // Date signed (also sets it for documents uploaded before I added this)
    private PropertyDocument? _dateDoc;
    private DateTime? _dateValue;
    private bool _dateSaving;
    private string? _dateError;

    private void OpenDateSigned(PropertyDocument doc)
    {
        _dateDoc = doc;
        _dateValue = doc.DateSigned;
        _dateError = null;
    }

    private async Task SaveDateSignedAsync()
    {
        if (_dateDoc is null) return;
        _dateError = _dateValue is null ? "Select the date the document was signed."
                   : _dateValue.Value.Date > PhTime.Now.Date ? "The date signed can't be in the future." : null;
        if (_dateError is not null) return;

        _dateSaving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.PropertyDocuments.FindAsync(_dateDoc.DocumentId);
            if (row is null) { _dateDoc = null; await RunFilterAsync(); return; }
            row.DateSigned = _dateValue!.Value.Date;
            await db.SaveChangesAsync();
            _dateDoc = null;
            await RunFilterAsync();
            await Toast("Date signed saved.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the date signed of document {Id} failed", _dateDoc?.DocumentId);
            _dateError = "Couldn't save the date. Check your connection and try again.";
        }
        finally { _dateSaving = false; }
    }

    private ValueTask Toast(string text, string type = "success") => JS.InvokeVoidAsync("showToast", text, type);

    // Live update: when documents or personnel change on either website, reload without refreshing.
    private static readonly string[] LiveAreas = ["documents", "personnel"];
    protected override void OnInitialized() => Live.AreasChanged += OnAreasAsync;

    private async Task OnAreasAsync(IReadOnlySet<string> areas)
    {
        if (!areas.Overlaps(LiveAreas)) return;
        await RunFilterAsync();
        StateHasChanged();
    }

    public void Dispose() => Live.AreasChanged -= OnAreasAsync;
}
