<!DOCTYPE html>
<html lang="en" data-season="@_season">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00007f" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme-init.js"]"></script>
    @* I serve everything from wwwroot so the system works without internet. *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin.css"]" />
    <link rel="stylesheet" href="@Assets["css/ris.css"]" />
    <link rel="stylesheet" href="@Assets["css/forms.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion.css"]" />
    <link rel="stylesheet" href="@Assets["css/season.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AMS_Storage_and_Report_System.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    @* Blazor shows this when the connection has an error, so buttons don't just silently do nothing. *@
    <div id="blazor-error-ui" data-nosnippet>
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <span>Something went wrong on this page. Reload to continue.</span>
        <a href="" class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss">✕</button>
    </div>
    <div id="toast-container" aria-live="polite"></div>
    <script src="@Assets["js/toast.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/live.js"]"></script>
    <script src="@Assets["js/ui.js"]"></script>
    <script src="@Assets["js/motion.js"]"></script>
    <script src="@Assets["js/season.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@inject SeasonState Season
@code {
    private string _season = "";   // seasonal theme for the headers and sidebar ("" means none)
    protected override async Task OnInitializedAsync() => _season = await Season.CurrentAsync();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // All pages are interactive except the ones marked [ExcludeFromInteractiveRouting] (Error).
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
