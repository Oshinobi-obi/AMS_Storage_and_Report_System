<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00007f" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme-init.js"]"></script>
    @* Everything is served from wwwroot so the system works without internet. *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin.css"]" />
    <link rel="stylesheet" href="@Assets["css/ris.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AMS_Storage_and_Report_System.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    @* Shown by Blazor when the interactive connection hits an error, instead of buttons silently doing nothing. *@
    <div id="blazor-error-ui" data-nosnippet>
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <span>Something went wrong on this page. Reload to continue.</span>
        <a href="" class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss">✕</button>
    </div>
    <div id="toast-container" aria-live="polite"></div>
    <script src="@Assets["js/toast.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/live.js"]"></script>
    <script src="@Assets["js/ui.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Every page is interactive except ones marked [ExcludeFromInteractiveRouting] (Error).
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
