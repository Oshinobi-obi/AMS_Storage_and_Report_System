@inherits LayoutComponentBase
@implements IDisposable
@inject ProfilePictureStorage ProfileStorage
@inject NavigationManager Nav
@inject ModalService Modal
@inject IJSRuntime JS

<div class="shell">
    @* Phone / tablet top bar *@
    <header class="mobile-bar">
        <button type="button" class="menu-btn" aria-label="Open menu" aria-expanded="@(_menuOpen ? "true" : "false")"
                aria-controls="app-sidebar" @onclick="() => _menuOpen = true">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <span class="brand-pill"><img src="images/one-ncr-stronger-together.png" alt="DepEd NCR" width="88" height="28" /></span>
    </header>

    <aside id="app-sidebar" class="sidebar @(_menuOpen ? "open" : "")" aria-label="Main menu">
        <div class="sidebar-brand">
            <a href="/dashboard" class="brand-pill" aria-label="AMS StockWatch dashboard">
                <img src="images/one-ncr-stronger-together.png" alt="DepEd NCR, One NCR Stronger Together" width="106" height="34" />
            </a>
            <p class="sidebar-app">
                <strong>AMS StockWatch</strong>
                <span>Asset Management Section</span>
            </p>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-group">
                <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All"><i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard</NavLink>
            </div>

            <div class="nav-group">
                <div class="nav-group-label">Supplies</div>
                <NavLink class="nav-item" href="requisitions"><i class="bi bi-inbox" aria-hidden="true"></i>Requisitions<span class="nav-soon">Next</span></NavLink>
                <NavLink class="nav-item" href="inventory"><i class="bi bi-box-seam" aria-hidden="true"></i>Inventory</NavLink>
                <NavLink class="nav-item" href="reports"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>Reports<span class="nav-soon">Soon</span></NavLink>
            </div>

            <div class="nav-group">
                <div class="nav-group-label">Records</div>
                <NavLink class="nav-item" href="employees"><i class="bi bi-people" aria-hidden="true"></i>Employees</NavLink>
                <NavLink class="nav-item" href="property-documents"><i class="bi bi-folder2-open" aria-hidden="true"></i>Property documents</NavLink>
            </div>

            <div class="nav-group">
                <div class="nav-group-label">Administration</div>
                <AuthorizeView Roles="SuperAdmin" Context="superAdmin">
                    <NavLink class="nav-item" href="account"><i class="bi bi-person-gear" aria-hidden="true"></i>Accounts</NavLink>
                </AuthorizeView>
                <NavLink class="nav-item" href="profile"><i class="bi bi-person-circle" aria-hidden="true"></i>My profile</NavLink>
                <NavLink class="nav-item" href="settings"><i class="bi bi-sliders" aria-hidden="true"></i>Settings<span class="nav-soon">Soon</span></NavLink>
            </div>
        </nav>

        <AuthorizeView>
            <Authorized>
                <div class="sidebar-foot">
                    <a class="user-chip" href="/profile">
                        <span class="avatar">
                            @if (PictureUrl(context) is { } url)
                            {
                                <img src="@url" alt="" />
                            }
                            else
                            {
                                @Initial(context)
                            }
                        </span>
                        <span class="user-chip-text">
                            <strong>@DisplayName(context)</strong>
                            <span>@RoleLabel(context)</span>
                        </span>
                    </a>
                    <form method="post" action="/account/logout" class="m-0" @ref="_logoutForm" autocomplete="off">
                        <AntiforgeryToken />
                        <button type="button" class="btn-logout" @onclick="ConfirmLogoutAsync">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>

    @if (_menuOpen)
    {
        <div class="sidebar-backdrop" @onclick="() => _menuOpen = false"></div>
    }

    <main class="shell-main">
        @Body
    </main>

    <ModalHost />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _menuOpen;
    private ElementReference _logoutForm;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // A user flagged "must change password" can only use their profile page.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        if (user.FindFirst("MustChangePassword")?.Value == "1")
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
            if (!path.StartsWith("/profile", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/profile?requirePasswordChange=true", replace: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmLogoutAsync()
    {
        if (await Modal.ConfirmAsync("Log out?", "You'll need to sign in again to use AMS StockWatch.",
                                     "Log out", "Stay signed in", ModalVariant.Warning))
            await JS.InvokeVoidAsync("ams.submitForm", _logoutForm);
    }

    private static string DisplayName(AuthenticationState s)
    {
        var name = s.User.FindFirst("DisplayName")?.Value;
        return !string.IsNullOrWhiteSpace(name) ? name : s.User.FindFirst("FullName")?.Value ?? s.User.Identity?.Name ?? "Signed in";
    }

    private static string Initial(AuthenticationState s) => DisplayName(s)[..1].ToUpperInvariant();

    private string? PictureUrl(AuthenticationState s) =>
        ProfileStorage.GetProfilePictureUrl(s.User.FindFirst("ProfilePicture")?.Value);

    private static string RoleLabel(AuthenticationState s) =>
        s.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value switch
        {
            "SuperAdmin" => "Super Admin",
            "Admin" => "Admin",
            var r => r ?? "",
        };

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
