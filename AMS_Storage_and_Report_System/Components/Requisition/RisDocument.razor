@* This is the Requisition and Issue Slip (Appendix 63), laid out like the AMS form (RIS.xlsx):
   Bookman Old Style, "Division Office: <office>" on one line, 14 item rows, a ruled Purpose box,
   and signature boxes with "Requested by:" and the others inside them.
   I use it for the cart preview (IsDraft), the office printout and the admin print page.
   The styles are in wwwroot/css/ris.css. *@

<article class="ris-sheet @(IsDraft ? "is-draft" : "")" aria-label="Requisition and Issue Slip">
    @if (IsDraft)
    {
        <div class="ris-watermark" aria-hidden="true">Preview</div>
    }

    <div class="ris-appendix">Appendix 63</div>
    <h1 class="ris-title">REQUISITION AND ISSUE SLIP</h1>

    <div class="ris-topline">
        <div>Entity Name: <span class="ris-fill">@Model.EntityName</span></div>
        <div>Fund Cluster: <span class="ris-fill ris-fill-sm">@Model.FundCluster</span></div>
    </div>

    <table class="ris-grid">
        <colgroup>
            <col class="c-stock" /><col class="c-unit" /><col class="c-desc" /><col class="c-qty" />
            <col class="c-yes" /><col class="c-no" /><col class="c-qty" /><col class="c-remarks" />
        </colgroup>
        <thead>
            <tr class="ris-meta">
                <td colspan="5" class="ris-division">Division Office: <strong>@DivisionOffice</strong></td>
                <td colspan="3" class="ris-rc">
                    <div>Responsibility Center Code: <strong>@Model.ResponsibilityCenterCode</strong></div>
                    <div>RIS No. <strong>@(Model.RisNo ?? "Assigned when submitted")</strong></div>
                </td>
            </tr>
            <tr class="ris-band">
                <th colspan="4" class="ris-em">Requisition</th>
                <th colspan="2" class="ris-em">Stock Available?</th>
                <th>Quantity</th>
                <th>Remarks</th>
            </tr>
            <tr class="ris-cols">
                <th>Stock No.</th><th>Unit</th><th>Description</th><th>Quantity</th>
                <th>Yes</th><th>No</th><th></th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr class="@(line.ItemId == HighlightItemId ? "is-highlight" : "")" @key="line.ItemId">
                    <td class="t-center">@line.StockNo</td>
                    <td class="t-center">@line.Unit</td>
                    <td>@line.Description</td>
                    <td class="t-center">@line.RequestedQty</td>
                    <td class="t-center">@(line.StockAvailable == true ? "✓" : "")</td>
                    <td class="t-center">@(line.StockAvailable == false ? "✓" : "")</td>
                    <td class="t-center">@line.IssuedQty</td>
                    <td>@line.Remarks</td>
                </tr>
            }
            @for (var i = Model.Lines.Count; i < MinRows; i++)
            {
                <tr class="ris-blank" aria-hidden="true"><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
            }
        </tbody>
    </table>

    <div class="ris-purpose">
        <span class="ris-purpose-label">Purpose:</span>
        <span class="ris-purpose-text">@Model.Purpose</span>
    </div>

    <table class="ris-sign">
        <colgroup><col class="s-label" /><col class="s-req" /><col class="s-app" /><col class="s-iss" /><col class="s-rec" /></colgroup>
        <tbody>
            <tr class="ris-sign-line">
                <th scope="row">Signature:</th>
                <td>Requested by:</td><td>Approved by:</td><td>Issued by:</td><td>Received by:</td>
            </tr>
            <tr>
                <th scope="row">Printed Name:</th>
                @foreach (var s in Signatories) { <td class="t-name">@s?.PrintedName</td> }
            </tr>
            <tr>
                <th scope="row">Designation:</th>
                @foreach (var s in Signatories) { <td class="t-desig">@s?.Designation</td> }
            </tr>
            <tr>
                <th scope="row">Date:</th>
                @foreach (var s in Signatories) { <td class="t-center">@s?.Date?.ToString("MM/dd/yyyy")</td> }
            </tr>
        </tbody>
    </table>
</article>

@code {
    [Parameter, EditorRequired] public RisDocumentModel Model { get; set; } = default!;
    [Parameter] public bool IsDraft { get; set; }
    /// When you hover a cart row, the same row on the RIS lights up.
    [Parameter] public int? HighlightItemId { get; set; }
    /// The AMS form has 14 item rows, so I draw the empty ones too to match the paper.
    [Parameter] public int MinRows { get; set; } = 14;

    private RisSignatory?[] Signatories => [Model.RequestedBy, Model.ApprovedBy, Model.IssuedBy, Model.ReceivedBy];

    /// The office that made the request, like "Asset Management Section" (one office only, same as the AMS form).
    private string DivisionOffice => string.IsNullOrWhiteSpace(Model.Office) ? Model.Division : Model.Office;
}
